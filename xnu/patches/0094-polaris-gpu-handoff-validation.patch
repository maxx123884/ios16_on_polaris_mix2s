@@ -7,6 +7,8 @@
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include "polaris_gpu_validate.h"
 
 extern bool polaris_touch_i2c_board(void);
 
@@ -46,6 +48,108 @@ static const char *const polaris_gpu_stage_name[POLARIS_GPU_STAGE_COUNT] = {
 	"HFI", "SMMU", "PAS13", "CP", "fence"
 };
 
+/*
+ * Reserved regions this driver must never map: the PAS13 zap carveout is 8 KiB
+ * of no-map memory behind a secure loader, and 0x9d400000 is ABL's splash
+ * framebuffer. Both values are this handset's, not generic SDM845 constants.
+ */
+#define POLARIS_GPU_ZAP_BASE	0x8c415000ull
+#define POLARIS_GPU_ZAP_BYTES	0x2000ull
+#define POLARIS_GPU_FB_BASE	0x9d400000ull
+#define POLARIS_GPU_FB_BYTES	0x2400000ull
+
+/* Names mkpayload.py must have placed in /chosen/memory-map, in blob order. */
+static const char *const polaris_gpu_blob_name[PG_BLOB_COUNT] = {
+	"GPU-SQE", "GPU-GMU", "GPU-ZAP-MDT",
+	"GPU-ZAP-B00", "GPU-ZAP-B01", "GPU-ZAP-B02"
+};
+
+/*
+ * Device-observed sizes with UNSET digests. As long as a digest here is zero,
+ * pg_expect_complete() refuses and the gate stops at the firmware stage: a
+ * handoff whose bytes were never hashed on this handset is not firmware we
+ * may start. Filling a digest is a separate, reviewable change that must come
+ * from the actual firmware files, never from an assumption.
+ */
+static const struct pg_expect polaris_gpu_expect[PG_BLOB_COUNT] = {
+	{ 32136, { 0 } }, { 32768, { 0 } }, { 6684, { 0 } },
+	{ 148, { 0 } }, { 6536, { 0 } }, { 1968, { 0 } }
+};
+
+/* ADT properties can be unaligned; copy rather than dereferencing as u64. */
+static bool
+polaris_gpu_adt_u64(DTEntry node, const char *key, uint64_t *value)
+{
+	const void *data = NULL;
+	unsigned int length = 0;
+
+	if (SecureDTGetProperty(node, key, &data, &length) != kSuccess ||
+	    data == NULL || length != sizeof(*value)) {
+		return false;
+	}
+	memcpy(value, data, sizeof(*value));
+	return true;
+}
+
+static bool
+polaris_gpu_adt_pair(DTEntry node, const char *key, struct pg_range *range)
+{
+	const void *data = NULL;
+	unsigned int length = 0;
+
+	if (SecureDTGetProperty(node, key, &data, &length) != kSuccess ||
+	    data == NULL || length != 16) {
+		return false;
+	}
+	memcpy(&range->base, data, sizeof(range->base));
+	memcpy(&range->size, (const uint8_t *)data + sizeof(range->base),
+	    sizeof(range->size));
+	return true;
+}
+
+/*
+ * Describe the boot handoff for validation. Read-only: no MMIO, no votes.
+ * A missing memory-map entry is reported, never defaulted to "close enough".
+ */
+static enum pg_status
+polaris_gpu_read_handoff(struct pg_handoff *handoff)
+{
+	DTEntry chosen, mmap;
+	unsigned int i;
+
+	memset(handoff, 0, sizeof(*handoff));
+	/* polaris_touch_i2c_board() already required both exact ADT identities. */
+	handoff->adt_polaris = true;
+	handoff->adt_sdm845 = true;
+	handoff->zap.base = POLARIS_GPU_ZAP_BASE;
+	handoff->zap.size = POLARIS_GPU_ZAP_BYTES;
+	handoff->splash.base = POLARIS_GPU_FB_BASE;
+	handoff->splash.size = POLARIS_GPU_FB_BYTES;
+
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    !polaris_gpu_adt_u64(chosen, "dram-base", &handoff->dram.base) ||
+	    !polaris_gpu_adt_u64(chosen, "dram-size", &handoff->dram.size)) {
+		return PG_EDRAM;
+	}
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &mmap) != kSuccess) {
+		printf("POLARIS GPU: no memory-map in ADT\n");
+		return PG_EBLOB_MISSING;
+	}
+	for (i = 0; i < PG_BLOB_COUNT; ++i) {
+		struct pg_range range;
+
+		if (!polaris_gpu_adt_pair(mmap, polaris_gpu_blob_name[i], &range)) {
+			printf("POLARIS GPU: ADT has no %s entry\n",
+			    polaris_gpu_blob_name[i]);
+			return PG_EBLOB_MISSING;
+		}
+		handoff->blob[i].pa = range.base;
+		handoff->blob[i].bytes = range.size;
+		/* Digest stays zero: proving it needs the files, see above. */
+	}
+	return PG_OK;
+}
+
