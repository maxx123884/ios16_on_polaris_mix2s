--- a/bsd/dev/polaris_gpu.c
+++ b/bsd/dev/polaris_gpu.c
@@ -1691,8 +1691,14 @@
 {
 	static int chan;
 
-	printf("POLARIS GPU: m1e thread: started, sleeping 15 s\n");
-	(void)tsleep(&chan, 0, "polarism1e", 15 * hz);
+	(void)chan;
+	printf("POLARIS GPU: m1e thread: started, waiting 15 s\n");
+	/*
+	 * tsleep never came back from this context, so this waits the crude way. A busy
