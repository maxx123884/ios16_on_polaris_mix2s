+/*
+ * Window walk: read one register at a time, flush after each, so the point where the bus
+ * stops answering is the last line on disk rather than a guess.
+ *
+ * The offsets climb from the start of the mapping to the GMU CSRs. If everything answers,
+ * the window is fine and the earlier hang was something else; if it stops at a particular
+ * offset, that is the region whose clock is missing.
+ */
+static void
+polaris_gx_m1f_walk(vm_offset_t win)
+{
+	static const uint32_t offs[] = {
+		0x0000u, 0x1000u, 0x8000u, 0x10000u, 0x14000u,
+		0x1F000u, 0x1F800u, 0x20000u, 0x23B11u, 0x2FFF0u,
+	};
+	unsigned int i;
+
+	printf("POLARIS GPU: m1f walk: starting\n");
+	sweet_log_sync();
+	delay(300000);
+
+	for (i = 0; i < sizeof(offs) / sizeof(offs[0]); i++) {
+		uint32_t v = polaris_reg_rd_b(win, offs[i]);
+
+		printf("POLARIS GPU: m1f walk: +0x%05x = 0x%08x\n", offs[i], v);
+		sweet_log_sync();
+		delay(200000);
+	}
+	printf("POLARIS GPU: m1f walk: done, all offsets answered\n");
+}
