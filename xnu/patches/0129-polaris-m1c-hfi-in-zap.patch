-/*
- * Reserved regions this driver must never map: the PAS13 zap carveout is 8 KiB
- * of no-map memory behind a secure loader, and 0x9d400000 is ABL's splash
- * framebuffer. Both values are this handset's, not generic SDM845 constants.
- */
-#define POLARIS_GPU_ZAP_BASE	0x8c415000ull
-#define POLARIS_GPU_ZAP_BYTES	0x2000ull
-#define POLARIS_GPU_FB_BASE	0x9d400000ull
-#define POLARIS_GPU_FB_BYTES	0x2400000ull
-
-/* Names mkpayload.py must have placed in /chosen/memory-map, in blob order. */
-static const char *const polaris_gpu_blob_name[PG_BLOB_COUNT] = {
-	"GPU-SQE", "GPU-GMU", "GPU-ZAP-MDT",
-	"GPU-ZAP-B00", "GPU-ZAP-B01", "GPU-ZAP-B02"
-};
-
-/*
- * The A630 firmware set this gate expects, pinned by size and SHA-256.
- *
- * Source: official China MIUI 12.5.1 fastboot package for polaris
- * (polaris_images_V12.5.1.0.QDGCNXM_20210707.0000.00_10.0_cn.tgz),
- * images/vendor.img, /firmware/. Extracted read-only by the port's
- * tools/ext4_extract.py; the manifest that names and proves the set lives in
- * the port repository at research/polaris/firmware-sets/
- * polaris-miui-12.5.1.0-qdgcnxm.json.
- *
- * a630_zap.mdt embeds the SHA-256 of b00 (offset 188) and b02 (offset 252), so
- * those four files are provably one signed bundle rather than four lookalikes.
- *
- * Difference from the handset this port was measured on: its a630_sqe.fw is
- * 32136 bytes, this set's is 31980 (version 0x016ee187), i.e. an earlier GPU
- * microcode revision. The table therefore states 31980 and the manifest states
- * why. Filling this table does NOT enable acceleration: this revision has no
- * digest backend, so polaris_gpu_read_handoff() still submits zero digests and
- * pg_validate_handoff() answers PG_EHASH_UNPROVEN. Regenerate with
- *   python3 tools/polaris_gpu_expect_table.py --firmware DIR \
- *       --manifest research/polaris/firmware-sets/<set>.json \
- *       --apply bsd/dev/polaris_gpu.c
- */
-static const struct pg_expect polaris_gpu_expect[PG_BLOB_COUNT] = {
-	/* GPU-SQE     a630_sqe.fw    */
-	{ 31980, { 0x34, 0xed, 0xac, 0xb6, 0xfd, 0xed, 0xfb, 0xfc, 0x07, 0xed, 0x5c, 0xd1, 0xd2, 0x9b, 0x0b, 0x57, 0xa3, 0x54, 0x3e, 0xf5, 0xbe, 0x6a, 0xb3, 0x4a, 0x43, 0xbd, 0x64, 0x68, 0x68, 0x26, 0xfa, 0x1e } },
-	/* GPU-GMU     a630_gmu.bin   */
-	{ 32768, { 0xb0, 0x7f, 0x90, 0x29, 0x9f, 0xf2, 0xae, 0x33, 0x94, 0x8f, 0xcf, 0xd6, 0xed, 0x67, 0xf5, 0x3f, 0xbd, 0x28, 0x7b, 0x5b, 0xf8, 0x5f, 0xf2, 0xd4, 0x3d, 0xb1, 0x1d, 0x4d, 0x32, 0xc1, 0x62, 0x1f } },
-	/* GPU-ZAP-MDT a630_zap.mdt   */
-	{ 6684, { 0x18, 0x82, 0xb2, 0x14, 0xd2, 0x4c, 0x13, 0xea, 0xe4, 0xff, 0xc3, 0x9b, 0xa5, 0x45, 0x6d, 0x5e, 0x61, 0xc8, 0x0b, 0x08, 0x9f, 0xb7, 0x7e, 0x8b, 0x15, 0xf7, 0xbd, 0xd0, 0x4b, 0xc9, 0xc8, 0x31 } },
-	/* GPU-ZAP-B00 a630_zap.b00   */
-	{ 148, { 0xb2, 0x97, 0x5f, 0x6a, 0x4c, 0x28, 0xa9, 0x81, 0x97, 0xc1, 0xd6, 0x94, 0xf6, 0xe2, 0x75, 0xe7, 0x1b, 0x23, 0xec, 0x7e, 0x31, 0xe3, 0x2f, 0xf5, 0xd1, 0xf8, 0x3f, 0xdb, 0x80, 0xa9, 0x42, 0x82 } },
-	/* GPU-ZAP-B01 a630_zap.b01   */
-	{ 6536, { 0xc9, 0x4d, 0xa0, 0xd6, 0xed, 0xf4, 0x82, 0x08, 0x85, 0xb8, 0x14, 0xec, 0xda, 0x2f, 0x91, 0xc8, 0x9b, 0x9d, 0x76, 0x61, 0x26, 0xc3, 0x57, 0x4c, 0x05, 0xd5, 0x80, 0xc4, 0x18, 0x81, 0x5b, 0x5f } },
-	/* GPU-ZAP-B02 a630_zap.b02   */
-	{ 1968, { 0x51, 0x9b, 0x55, 0x38, 0x80, 0x9f, 0x54, 0xee, 0x56, 0x62, 0x46, 0xb0, 0x52, 0x07, 0x46, 0xa8, 0xea, 0x82, 0xca, 0x93, 0x84, 0xea, 0x6b, 0xdd, 0xb0, 0xb0, 0xe0, 0xd3, 0xc2, 0xde, 0x52, 0x0c } }
-};
-
-/* ADT properties can be unaligned; copy rather than dereferencing as u64. */
-static bool
-polaris_gpu_adt_u64(DTEntry node, const char *key, uint64_t *value)
-{
-	const void *data = NULL;
-	unsigned int length = 0;
-
-	if (SecureDTGetProperty(node, key, &data, &length) != kSuccess ||
-	    data == NULL || length != sizeof(*value)) {
-		return false;
-	}
-	memcpy(value, data, sizeof(*value));
-	return true;
-}
-
-static bool
-polaris_gpu_adt_pair(DTEntry node, const char *key, struct pg_range *range)
-{
-	const void *data = NULL;
-	unsigned int length = 0;
-
-	if (SecureDTGetProperty(node, key, &data, &length) != kSuccess ||
-	    data == NULL || length != 16) {
-		return false;
-	}
-	memcpy(&range->base, data, sizeof(range->base));
-	memcpy(&range->size, (const uint8_t *)data + sizeof(range->base),
-	    sizeof(range->size));
-	return true;
-}
-
-/*
- * Describe the boot handoff for validation. Read-only: no MMIO, no votes.
- * A missing memory-map entry is reported, never defaulted to "close enough".
- */
-static enum pg_status
-polaris_gpu_read_handoff(struct pg_handoff *handoff)
-{
-	DTEntry chosen, mmap;
-	unsigned int i;
-
-	memset(handoff, 0, sizeof(*handoff));
-	/* polaris_touch_i2c_board() already required both exact ADT identities. */
-	handoff->adt_polaris = true;
-	handoff->adt_sdm845 = true;
-	handoff->zap.base = POLARIS_GPU_ZAP_BASE;
-	handoff->zap.size = POLARIS_GPU_ZAP_BYTES;
-	handoff->splash.base = POLARIS_GPU_FB_BASE;
-	handoff->splash.size = POLARIS_GPU_FB_BYTES;
-
-	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
-	    !polaris_gpu_adt_u64(chosen, "dram-base", &handoff->dram.base) ||
-	    !polaris_gpu_adt_u64(chosen, "dram-size", &handoff->dram.size)) {
-		return PG_EDRAM;
-	}
-	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &mmap) != kSuccess) {
-		printf("POLARIS GPU: no memory-map in ADT\n");
-		return PG_EBLOB_MISSING;
-	}
-	for (i = 0; i < PG_BLOB_COUNT; ++i) {
-		struct pg_range range;
-
-		if (!polaris_gpu_adt_pair(mmap, polaris_gpu_blob_name[i], &range)) {
-			printf("POLARIS GPU: ADT has no %s entry\n",
-			    polaris_gpu_blob_name[i]);
-			return PG_EBLOB_MISSING;
-		}
-		handoff->blob[i].pa = range.base;
-		handoff->blob[i].bytes = range.size;
-		/*
-		 * No digest backend exists in this revision, so the digest stays
-		 * zero and the validator answers PG_EHASH_UNPROVEN. Hashing here
-		 * is the next reviewable step, not something to fake.
-		 */
-	}
-	return PG_OK;
-}
-
-/*
- * M0a read-only probe (0097). Nine words that say what the GX domain is right
- * now, read and nothing else: no write, no vote, no power-on, and the gate
- * still refuses at this stage afterwards. Addresses come from the vendor
- * device tree (research/polaris/m0a-gx-readonly-probe.zh-CN.md section 2).
- *
- * A wrong window base would not fault - it would silently read a neighbouring
- * block - so every word is checked against the two windows before it is read.
- * The reads are one at a time and each is printed as it lands: the open
- * question is whether reading GMU CSR with the domain unclocked is even legal,
- * and if it aborts, the console ring still holds the values that did arrive.
- */
-#define POLARIS_GMU_PA      0x0506a000ULL
-#define POLARIS_GMU_REQ_PA  0x0508ec1cULL	/* GMU_RSCC_CONTROL_REQ */
-#define POLARIS_GMU_ACK_PA  0x0508ec20ULL	/* GMU_RSCC_CONTROL_ACK */
-#define POLARIS_GMU_SIZE    0x00030000ULL
-#define POLARIS_PDC_PA      0x0b200000ULL
-/* Vendor DT: 0x0b200000 + 0x300000. 0x30000 puts 0x0b284500 outside and
- * the probe refused before it could read the three control words. */
-#define POLARIS_PDC_SIZE    0x00300000ULL
-
-struct polaris_gx_word {
-	const char *name;
-	uint64_t    pa;
-	int         bit;        /* value bit worth naming, -1 for none */
-};
-
-static const struct polaris_gx_word polaris_gx_words[] = {
-	{ "RSCC_RSC_STATUS0_DRV0",   0x0508d010ULL, 16 },
-	{ "RSCC_PDC_SLAVE_ID_DRV0",  0x0508d02cULL, -1 },
-	{ "RSCC_PDC_SEQ_START_ADDR", 0x0508d020ULL, -1 },
-	{ "RSCC_PDC_MATCH_VALUE_LO", 0x0508d024ULL, -1 },
-	{ "RSCC_PDC_MATCH_VALUE_HI", 0x0508d028ULL, -1 },
-	{ "PDC_GPU_ENABLE_PDC",      0x0b284500ULL,  0 },
-	{ "RSCC_SEQ_BUSY_DRV0",      0x0508d404ULL, -1 },
-	{ "GMU_RSCC_CONTROL_REQ",    0x0508ec1cULL,  1 },
-	{ "GMU_RSCC_CONTROL_ACK",    0x0508ec20ULL,  1 },
-};
-
-/*
- * polarisgxm0b=1 asks the PDC for GX power; =2 first enables the PDC itself
- * (bit0 of PDC_GPU_ENABLE), because =1 on the phone showed the request landing
- * and nothing acting on it.
- */
-#define POLARIS_PDC_ENABLE_PA	0x0b284500ULL
-/*
- * The vendor writes PDC_GPU_ENABLE_PDC = 0x80000001 (_load_gmu_rpmh_ucode in
- * adreno_a6xx.c), and tools/polaris_gmu_csr.py has carried that value since it
- * was written. mode 2 wrote only 0x1, which is why it looked like the enable was
- * accepted and nothing happened. OR rather than a literal store, so bits this
- * port does not know about are kept.
- */
-#define POLARIS_PDC_ENABLE_VALUE	0x80000001u
-
-/* Filled by polaris_gx_readonly_probe(); read by the decision and by M0b. */
-static struct pg_gx_state polaris_gx_last;
-static bool polaris_gx_last_valid;
-
-extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
-extern void ml_io_unmap(vm_offset_t, vm_size_t);
-extern void delay(int);	/* microseconds in XNU; M0b waits in 1 ms steps */
-/* vm/pmap.h and kern/kalloc.h sit behind KERNEL_PRIVATE, which this file is not
- * compiled with, so the few prototypes needed are declared here - the same way
- * bzero/delay/memcpy already are. */
-#if !defined(pmap_kernel)
-extern void *pmap_kernel(void);	/* a macro in the real build's vm/pmap.h */
-#endif
-extern unsigned int pmap_find_phys(void *pmap, uint64_t va);
-extern void *kalloc(vm_size_t size);
-extern void bzero(void *b, size_t len);
-extern void kfree(void *addr, vm_size_t size);
-extern unsigned int ml_get_cpu_count(void);	/* for the CPU liveness report */
-
-static bool
-polaris_gx_in_window(uint64_t pa)
-{
-	if (pa >= POLARIS_GMU_PA && pa < POLARIS_GMU_PA + POLARIS_GMU_SIZE) {
-		return true;
-	}
-	if (pa >= POLARIS_PDC_PA && pa < POLARIS_PDC_PA + POLARIS_PDC_SIZE) {
-		return true;
-	}
-	return false;
-}
-
-static void
-polaris_gx_readonly_probe(void)
-{
-	vm_offset_t gmu, pdc;
-	size_t i, words = sizeof(polaris_gx_words) / sizeof(polaris_gx_words[0]);
-	struct pg_gx_state gx = { false, 0, 0, 0, 0, 0 };
-	bool complete = true;
-
-	polaris_gx_last_valid = false;
-
-	gmu = ml_io_map((vm_offset_t)POLARIS_GMU_PA, (vm_size_t)POLARIS_GMU_SIZE);
-	pdc = ml_io_map((vm_offset_t)POLARIS_PDC_PA, (vm_size_t)POLARIS_PDC_SIZE);
-	if (gmu == 0 || pdc == 0) {
-		printf("POLARIS GPU: gx probe refused; window map failed (gmu %d pdc %d)\n",
-		    gmu != 0, pdc != 0);
-		return;
-	}
-
-	for (i = 0; i < words; i++) {
-		const struct polaris_gx_word *w = &polaris_gx_words[i];
-		volatile const uint32_t *reg;
-		uint32_t first, second;
-
-		if (!polaris_gx_in_window(w->pa) || (w->pa & 0x3) != 0) {
-			printf("POLARIS GPU: gx probe refused; %s outside the two windows\n",
-			    w->name);
-			complete = false;
-			break;
-		}
-		if (w->pa >= POLARIS_PDC_PA) {
-			reg = (volatile const uint32_t *)(uintptr_t)(pdc +
-			    (w->pa - POLARIS_PDC_PA));
-		} else {
-			reg = (volatile const uint32_t *)(uintptr_t)(gmu +
-			    (w->pa - POLARIS_GMU_PA));
-		}
-		first = *reg;
-		second = *reg;
-		switch (i) {
-		case 2: gx.seq_start = first; break;
-		case 5: gx.pdc_enable = first; break;
-		case 6: gx.seq_busy = first; break;
-		case 7: gx.control_req = first; break;
-		case 8: gx.control_ack = first; break;
-		default: break;
-		}
-		printf("POLARIS GPU: gx %-24s @0x%08llx = 0x%08x\n", w->name,
-		    (unsigned long long)w->pa, first);
-		if (w->bit >= 0) {
-			printf("POLARIS GPU: gx %-24s bit%d = %u\n", w->name, w->bit,
-			    (unsigned)((first >> w->bit) & 1u));
-		}
-		if (first == 0xffffffffu && second == 0xffffffffu) {
-			printf("POLARIS GPU: gx probe stopped; %s reads all ones\n",
-			    w->name);
-			complete = false;
-			break;
-		}
-	}
-
-	/*
-	 * The decision, not the read, is what may ever authorise a write. It is
-	 * printed here as a plan: this revision still writes nothing.
-	 */
-	if (complete) {
-		gx.firmware_proven = true;	/* the probe runs only after the digests matched */
-		polaris_gx_last = gx;
-		polaris_gx_last_valid = true;
-		printf("POLARIS GPU: gx decision: %s (plan only; nothing written)\n",
-		    pg_gx_action_name(pg_gx_decide(&gx)));
-	}
-
-	/*
-	 * No unmap. ml_io_unmap() on these mappings panics in vm_map_delete
-	 * ("start is not aligned"), and the gate is about to refuse anyway, so the
-	 * two windows stay mapped for the life of this boot. Same as the hash path.
-	 */
-}
-
-/*
- * M0b: the first write this port makes to hardware, and it is one bit.
- *
- * research/polaris/m0b-gx-power-request.zh-CN.md fixes the shape: snapshot, set
- * GMU_RSCC_CONTROL_REQ bit1, wait up to 20 ms for CONTROL_ACK bit1, snapshot
- * again, clear the request, wait for the acknowledge to fall, and report. The
- * request is withdrawn immediately because this port owns no clock vote and no
- * GMU firmware - leaving GX powered on our behalf would be a decision about a
- * domain we do not own.
- *
- * The outcome that stops everything: acknowledge rises and does not fall. That
- * would mean we can ask for power but not give it back, and no later stage may
- * run on top of that.
- */
-#define POLARIS_M0B_WAIT_MS	20u
-
-static void
-polaris_gx_m0b(unsigned int mode)
-{
-	vm_offset_t gmu, pdc = 0;
-	volatile uint32_t *req, *ack, *enable = NULL;
-	uint32_t before, pdc_before = 0, i;
-	bool acked = false, cleared = false, pdc_owned = false;
-
-	gmu = ml_io_map((vm_offset_t)POLARIS_GMU_PA, (vm_size_t)POLARIS_GMU_SIZE);
-	if (gmu == 0) {
-		printf("POLARIS GPU: m0b refused; GMU window map failed\n");
-		return;
-	}
-	req = (volatile uint32_t *)(uintptr_t)(gmu +
-	    (POLARIS_GMU_REQ_PA - POLARIS_GMU_PA));
-	ack = (volatile uint32_t *)(uintptr_t)(gmu +
-	    (POLARIS_GMU_ACK_PA - POLARIS_GMU_PA));
-
-	printf("POLARIS GPU: m0b pre: ack 0x%08x req 0x%08x busy 0x%08x pdc 0x%08x seq 0x%08x\n",
-	    polaris_gx_last.control_ack, polaris_gx_last.control_req,
-	    polaris_gx_last.seq_busy, polaris_gx_last.pdc_enable,
-	    polaris_gx_last.seq_start);
-
-	/*
-	 * Mode 2 also enables the PDC itself (bit0 of PDC_GPU_ENABLE), because
-	 * mode 1 proved the request is delivered and nothing acts on it. The
-	 * acknowledge is read again the moment PDC is enabled: if it rises by
-	 * itself, enabling the PDC is enough to power GX, and that is a different
-	 * contract than the one this experiment assumes - restore and stop.
-	 */
-	if (mode >= 2) {
-		pdc = ml_io_map((vm_offset_t)POLARIS_PDC_PA, (vm_size_t)POLARIS_PDC_SIZE);
-		if (pdc == 0) {
-			printf("POLARIS GPU: m0b refused; PDC window map failed\n");
-			return;
-		}
-		enable = (volatile uint32_t *)(uintptr_t)(pdc +
-		    (POLARIS_PDC_ENABLE_PA - POLARIS_PDC_PA));
-		pdc_before = *enable;
-		*enable = pdc_before | POLARIS_PDC_ENABLE_VALUE;
-#if defined(__aarch64__)
-		__asm__ volatile ("dsb sy" ::: "memory");
-#endif
-		pdc_owned = true;
-		printf("POLARIS GPU: m0b pdc enable 0x%08x -> 0x%08x\n", pdc_before, *enable);
-		delay(1000);
-		printf("POLARIS GPU: m0b pdc post: ack 0x%08x (must still be 0)\n", *ack);
-		if ((*ack & PG_GX_BIT_ON) != 0) {
-			*enable = pdc_before;
-#if defined(__aarch64__)
-			__asm__ volatile ("dsb sy" ::: "memory");
-#endif
-			printf("POLARIS GPU: m0b quarantined: enabling PDC alone powered GX; restored\n");
-			return;
-		}
-	}
-
-	before = *req;
-	*req = before | PG_GX_BIT_ON;
-#if defined(__aarch64__)
-	/* Device-nGnRnE orders the store; dsb waits for it to complete. */
-	__asm__ volatile ("dsb sy" ::: "memory");
-#endif
-	printf("POLARIS GPU: m0b set req 0x%08x -> 0x%08x\n", before, *req);
-
-	for (i = 0; i < POLARIS_M0B_WAIT_MS; i++) {
-		delay(1000);	/* 1 ms */
-		if ((*ack & PG_GX_BIT_ON) != 0) {
-			acked = true;
-			break;
-		}
-	}
-	printf("POLARIS GPU: m0b ack 0x%08x after %u ms\n", *ack, (unsigned)(i + 1));
-
-	printf("POLARIS GPU: m0b post: ack 0x%08x req 0x%08x\n", *ack, *req);
-
-	/* Withdraw the request whatever happened above: no state is kept. */
-	*req = *req & ~PG_GX_BIT_ON;
-#if defined(__aarch64__)
-	/* Device-nGnRnE orders the store; dsb waits for it to complete. */
-	__asm__ volatile ("dsb sy" ::: "memory");
-#endif
-	printf("POLARIS GPU: m0b cleared req -> 0x%08x\n", *req);
-
-	for (i = 0; i < POLARIS_M0B_WAIT_MS; i++) {
-		delay(1000);
-		if ((*ack & PG_GX_BIT_ON) == 0) {
-			cleared = true;
-			break;
-		}
-	}
-	printf("POLARIS GPU: m0b ack 0x%08x after %u ms\n", *ack, (unsigned)(i + 1));
-
-	if (pdc_owned) {
-		*enable = pdc_before;
-#if defined(__aarch64__)
-		__asm__ volatile ("dsb sy" ::: "memory");
-#endif
-		printf("POLARIS GPU: m0b pdc restored -> 0x%08x\n", *enable);
-	}
-
-	if (acked && cleared) {
-		printf("POLARIS GPU: m0b done: request/ack/clear closed, GX back to off\n");
-	} else if (!acked) {
-		printf("POLARIS GPU: m0b quarantined: no acknowledge; check PDC_GPU_ENABLE bit0\n");
-	} else {
-		printf("POLARIS GPU: m0b quarantined: acknowledge did not fall; no powered state owned\n");
-	}
-	/* No unmap: same reason as the probe - it panics in vm_map_delete here. */
-}
