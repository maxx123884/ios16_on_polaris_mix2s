-/*
- * Only an acquired resource may be released. Resource-specific release
- * callbacks must be installed before ANY power or mapping code is enabled.
- * No stages after the board stage have a backend in this revision.
- */
-static bool
-polaris_gpu_enter(struct polaris_gpu_context *ctx, enum polaris_gpu_stage stage)
-{
-	if (ctx->state != POLARIS_GPU_STARTING ||
-	    stage != (enum polaris_gpu_stage)ctx->completed ||
-	    stage >= POLARIS_GPU_STAGE_COUNT) {
-		return false;
-	}
-	if (stage != POLARIS_GPU_BOARD) {
-		if (stage == POLARIS_GPU_FIRMWARE) {
-			int probe = 0, m1 = 0;
-
-			int m0b = 0;
-
-			/* Opt-in and read-only; reached only after the digests matched. */
-			PE_parse_boot_argn("polarisgxprobe", &probe, sizeof(probe));
-			if (probe) {
-				polaris_gx_readonly_probe();
-			}
-			/* M1a: GCC and GPUCC reads, step-limited, its own opt-in. */
-			{
-				int m1a = 0;
-
-				PE_parse_boot_argn("polarisgxm1", &m1a, sizeof(m1a));
-				if (m1a >= 1) {
-					polaris_gx_m1a(m1a);
-				}
-			}
-			/* Read-only CPU liveness report, its own opt-in too. */
-			{
-				int cpu = 0;
-
-				PE_parse_boot_argn("polariscpu", &cpu, sizeof(cpu));
-				if (cpu != 0) {
-					polaris_cpu_report();
-				}
-			}
-			/* Read-only GMU feasibility check, its own opt-in as well. */
-			PE_parse_boot_argn("polarisgmgmu", &m1, sizeof(m1));
-			if (probe && m1 != 0) {
-				polaris_gx_m1_probe();
-			}
-			/* The write has its own switch: probing must never cause one. */
-			PE_parse_boot_argn("polarisgxm0b", &m0b, sizeof(m0b));
-			if (probe && m0b >= 1 && polaris_gx_last_valid &&
-			    pg_gx_decide(&polaris_gx_last) == PG_GX_WRITE_REQ) {
-				if (m0b >= 3) {
-					int steps = -1;
-
-					PE_parse_boot_argn("polarisgxm0csteps", &steps, sizeof(steps));
-					polaris_m0c_steps_left = steps;
-					polaris_gx_m0c();
-				} else {
-					polaris_gx_m0b((unsigned int)m0b);
-				}
-			}
-		}
-		printf("POLARIS GPU: %s backend not implemented; no hardware access\n",
-		    polaris_gpu_stage_name[stage]);
-		return false;
-	}
-	/* Board identity is checked again here, not only at the caller. */
-	if (!polaris_touch_i2c_board()) {
-		return false;
-	}
-	ctx->completed++;
-	/* The board predicate acquires nothing; owned remains zero. */
-	return true;
-}
