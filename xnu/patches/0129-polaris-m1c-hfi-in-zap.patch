-/* The handful of writes the vendor does outside that table, in its order. */
-#define POLARIS_RSC_STATUS0_PA		0x0508d010ULL	/* |= BIT(24) */
-#define POLARIS_RSC_STATUS0_BIT		24u
-#define POLARIS_PDC_SLAVE_ID_PA		0x0508d02cULL	/* = 1 */
-#define POLARIS_HIDDEN_TCS_ADDR_PA	0x0508d034ULL	/* +0, +8, +16 */
-#define POLARIS_HIDDEN_TCS_DATA_PA	0x0508d038ULL	/* +0, +8, +16 */
-#define POLARIS_OVERRIDE_START_PA	0x0508d400ULL	/* = 0 */
-#define POLARIS_REQ_PA			0x0508ec1cULL
-#define POLARIS_ACK_PA			0x0508ec20ULL
-#define POLARIS_SEQ_BUSY_PA		0x0508d404ULL
-#define POLARIS_M0C_WAIT_MS		100u
-/* RSCC_TCS{0,1,3}_DRV0_STATUS, converted from their a6xx_reg.h indices. */
-#define POLARIS_TCS0_STATUS_PA		0x0508dd18ULL	/* index 0x23746 */
-#define POLARIS_TCS1_STATUS_PA		0x0508e2b8ULL	/* index 0x238AE */
-#define POLARIS_TCS3_STATUS_PA		0x050907f8ULL	/* index 0x23B7E */
-
-static uint32_t *
-polaris_m0c_word(vm_offset_t gmu, vm_offset_t pdc, uint64_t pa)
-{
-	if (pa >= POLARIS_PDC_PA) {
-		return (uint32_t *)(uintptr_t)(pdc + (pa - POLARIS_PDC_PA));
-	}
-	return (uint32_t *)(uintptr_t)(gmu + (pa - POLARIS_GMU_PA));
-}
-
-/*
- * Every write is announced before it happens. A hang here leaves the console
- * ring un-flushed (the gate runs before the first flush), but kprintf also draws
- * on the framebuffer, so the last line on the screen names the write that
- * stopped the SoC. That is the bisection signal this sequence needs.
- */
-/*
- * The console ring is flushed by a thread on a one second timer, and the gate
- * runs long before the first flush - which is why a hang here used to leave the
- * ring empty. So every write waits out one flush period after announcing itself:
- * if the store locks the bus, the line naming it is already in flash.
- */
-#define POLARIS_M0C_FLUSH_US	1300000	/* default sweet_log_secs is 1 */
-
-static int polaris_m0c_steps_left = -1;	/* -1: no limit, else remaining writes */
-
-/*
- * Read-only: which TCS the sequencer is on. Reads cannot change state, so this
- * is what M0c asks once the acknowledge fails to arrive.
- */
-static void
-polaris_m0c_tcs(const char *when, vm_offset_t gmu, vm_offset_t pdc)
-{
-	printf("POLARIS GPU: m0c tcs %s: tcs0 0x%08x tcs1 0x%08x tcs3 0x%08x busy 0x%08x status0 0x%08x\n",
-	    when,
-	    *polaris_m0c_word(gmu, pdc, POLARIS_TCS0_STATUS_PA),
-	    *polaris_m0c_word(gmu, pdc, POLARIS_TCS1_STATUS_PA),
-	    *polaris_m0c_word(gmu, pdc, POLARIS_TCS3_STATUS_PA),
-	    *polaris_m0c_word(gmu, pdc, POLARIS_SEQ_BUSY_PA),
-	    *polaris_m0c_word(gmu, pdc, POLARIS_RSC_STATUS0_PA));
-}
-
-static void
-polaris_m0c_write(vm_offset_t gmu, vm_offset_t pdc, uint64_t pa, uint32_t value)
-{
-	if (polaris_m0c_steps_left == 0) {
-		printf("POLARIS GPU: m0c stop: step limit reached before 0x%08llx\n",
-		    (unsigned long long)pa);
-		return;
-	}
-	if (polaris_m0c_steps_left > 0) {
-		polaris_m0c_steps_left--;
-	}
-	printf("POLARIS GPU: m0c write 0x%08llx = 0x%08x (was 0x%08x)\n",
-	    (unsigned long long)pa, value, *polaris_m0c_word(gmu, pdc, pa));
-	delay(POLARIS_M0C_FLUSH_US);
-	*polaris_m0c_word(gmu, pdc, pa) = value;
-#if defined(__aarch64__)
-	__asm__ volatile ("dsb sy" ::: "memory");
-#endif
-}
-
-static void
-polaris_gx_m0c(void)
-{
-	vm_offset_t gmu, pdc;
-	volatile uint32_t *req, *ack, *busy, *status0;
-	static uint32_t snapshot[sizeof(polaris_m0c_plan) / sizeof(polaris_m0c_plan[0])];
-	uint32_t singles[5];
-	size_t i, words = sizeof(polaris_m0c_plan) / sizeof(polaris_m0c_plan[0]);
-	bool acked = false, idle = false, slept = false;
-
-	gmu = ml_io_map((vm_offset_t)POLARIS_GMU_PA, (vm_size_t)POLARIS_GMU_SIZE);
-	pdc = ml_io_map((vm_offset_t)POLARIS_PDC_PA, (vm_size_t)POLARIS_PDC_SIZE);
-	if (gmu == 0 || pdc == 0) {
-		printf("POLARIS GPU: m0c refused; window map failed\n");
-		return;
-	}
-
-	/* Refuse before touching anything if a table entry is outside its window. */
-	for (i = 0; i < words; i++) {
-		if (!polaris_gx_in_window(polaris_m0c_plan[i].pa) ||
-		    (polaris_m0c_plan[i].pa & 0x3) != 0) {
-			printf("POLARIS GPU: m0c refused; table entry %u outside the two windows\n",
-			    (unsigned)i);
-			return;
-		}
-	}
-
-	req = polaris_m0c_word(gmu, pdc, POLARIS_REQ_PA);
-	ack = polaris_m0c_word(gmu, pdc, POLARIS_ACK_PA);
-	busy = polaris_m0c_word(gmu, pdc, POLARIS_SEQ_BUSY_PA);
-	status0 = polaris_m0c_word(gmu, pdc, POLARIS_RSC_STATUS0_PA);
-
-	/* Snapshot everything this is about to change, before changing any of it. */
-	for (i = 0; i < words; i++) {
-		snapshot[i] = *polaris_m0c_word(gmu, pdc, polaris_m0c_plan[i].pa);
-	}
-	singles[0] = *status0;
-	singles[1] = *polaris_m0c_word(gmu, pdc, POLARIS_PDC_SLAVE_ID_PA);
-	singles[2] = *polaris_m0c_word(gmu, pdc, POLARIS_HIDDEN_TCS_ADDR_PA);
-	singles[3] = *polaris_m0c_word(gmu, pdc, POLARIS_HIDDEN_TCS_DATA_PA);
-	singles[4] = *polaris_m0c_word(gmu, pdc, POLARIS_OVERRIDE_START_PA);
-	printf("POLARIS GPU: m0c pre: ack 0x%08x req 0x%08x busy 0x%08x status0 0x%08x enable 0x%08x pdcseq 0x%08x\n",
-	    *ack, *req, *busy, *status0,
-	    *polaris_m0c_word(gmu, pdc, 0x0b284500ULL),
-	    *polaris_m0c_word(gmu, pdc, 0x0b480000ULL));
-	delay(POLARIS_M0C_FLUSH_US);
-
-	/* The vendor's order: SDE gate, slave id, hidden TCS, override, then ucode. */
-	polaris_m0c_write(gmu, pdc, POLARIS_RSC_STATUS0_PA,
-	    singles[0] | (1u << POLARIS_RSC_STATUS0_BIT));
-	polaris_m0c_write(gmu, pdc, POLARIS_PDC_SLAVE_ID_PA, 1u);
-	polaris_m0c_write(gmu, pdc, POLARIS_HIDDEN_TCS_DATA_PA, 0u);
-	polaris_m0c_write(gmu, pdc, POLARIS_HIDDEN_TCS_ADDR_PA, 0u);
-	polaris_m0c_write(gmu, pdc, POLARIS_HIDDEN_TCS_DATA_PA + 8, 0u);
-	polaris_m0c_write(gmu, pdc, POLARIS_HIDDEN_TCS_ADDR_PA + 8, 0u);
-	polaris_m0c_write(gmu, pdc, POLARIS_HIDDEN_TCS_DATA_PA + 16, 0x80000000u);
-	polaris_m0c_write(gmu, pdc, POLARIS_HIDDEN_TCS_ADDR_PA + 16, 0u);
-	polaris_m0c_write(gmu, pdc, POLARIS_OVERRIDE_START_PA, 0u);
-
-	for (i = 0; i < words; i++) {
-		polaris_m0c_write(gmu, pdc, polaris_m0c_plan[i].pa, polaris_m0c_plan[i].value);
-	}
-#if defined(__aarch64__)
-	__asm__ volatile ("dsb sy" ::: "memory");
-#endif
-	printf("POLARIS GPU: m0c loaded: enable 0x%08x pdcseq 0x%08x rsccseq 0x%08x\n",
-	    *polaris_m0c_word(gmu, pdc, 0x0b284500ULL),
-	    *polaris_m0c_word(gmu, pdc, 0x0b480000ULL),
-	    *polaris_m0c_word(gmu, pdc, 0x0508d600ULL));
-
-	polaris_m0c_tcs("before req", gmu, pdc);
-
-	/* Wake request, then the vendor's two waits. */
-	*req = PG_GX_BIT_ON;
-#if defined(__aarch64__)
-	__asm__ volatile ("dsb sy" ::: "memory");
-#endif
-	for (i = 0; i < POLARIS_M0C_WAIT_MS; i++) {
-		delay(1000);
-		if ((*ack & PG_GX_BIT_ON) != 0) {
-			acked = true;
-			break;
-		}
-	}
-	printf("POLARIS GPU: m0c ack 0x%08x after %u ms\n", *ack, (unsigned)(i + 1));
-	polaris_m0c_tcs("after req", gmu, pdc);
-	if (acked) {
-		for (i = 0; i < POLARIS_M0C_WAIT_MS; i++) {
-			delay(1000);
-			if (*busy == 0u) {
-				idle = true;
-				break;
-			}
-		}
-		printf("POLARIS GPU: m0c busy 0x%08x after %u ms\n", *busy, (unsigned)(i + 1));
-	}
-
-	/*
-	 * Power back down the vendor's way (a6xx_rpmh_power_off_gpu): REQ bit0 is
-	 * the sleep request, and RSC_STATUS0 bit16 says the rail came down. This
-	 * runs whether or not the wake worked, because a half-woken domain is not
-	 * a state this port may leave behind.
-	 */
-	*req = 1u;
-#if defined(__aarch64__)
-	__asm__ volatile ("dsb sy" ::: "memory");
-#endif
-	/*
-	 * Only wait for the rail to come down if it ever came up. status0 bit16 is
-	 * set whenever GX is off, so polling it after a failed wake "succeeds" on the
-	 * first read and says nothing - which is exactly the false positive this port
-	 * printed once already.
-	 */
-	if (acked) {
-		for (i = 0; i < POLARIS_M0C_WAIT_MS; i++) {
-			delay(1000);
-			if ((*status0 & (1u << 16)) != 0) {
-				slept = true;
-				break;
-			}
-		}
-		printf("POLARIS GPU: m0c sleep status0 0x%08x after %u ms\n",
-		    *status0, (unsigned)(i + 1));
-	} else {
-		printf("POLARIS GPU: m0c sleep skipped: GX never woke (status0 0x%08x)\n", *status0);
-	}
-	*req = 0u;
-#if defined(__aarch64__)
-	__asm__ volatile ("dsb sy" ::: "memory");
-#endif
-
-	/*
-	 * If the sequencer is still busy, do not pull its program out from under it:
-	 * clear the enable (so the PDC is not left armed) and stop, leaving the
-	 * ucode in place for the next analysis.
-	 */
-	if (*busy != 0u) {
-		polaris_m0c_write(gmu, pdc, 0x0b284500ULL, 0u);
-		printf("POLARIS GPU: m0c quarantined: sequencer still busy (0x%08x); ucode left loaded, PDC disabled\n",
-		    *busy);
-		return;
-	}
-
-	/* Restore: ucode and TCS banks go back exactly as they were found. */
-	for (i = 0; i < words; i++) {
-		polaris_m0c_write(gmu, pdc, polaris_m0c_plan[i].pa, snapshot[i]);
-	}
-	polaris_m0c_write(gmu, pdc, POLARIS_RSC_STATUS0_PA, singles[0]);
-	polaris_m0c_write(gmu, pdc, POLARIS_PDC_SLAVE_ID_PA, singles[1]);
-	polaris_m0c_write(gmu, pdc, POLARIS_HIDDEN_TCS_ADDR_PA, singles[2]);
-	polaris_m0c_write(gmu, pdc, POLARIS_HIDDEN_TCS_DATA_PA, singles[3]);
-	polaris_m0c_write(gmu, pdc, POLARIS_OVERRIDE_START_PA, singles[4]);
-#if defined(__aarch64__)
-	__asm__ volatile ("dsb sy" ::: "memory");
-#endif
-	printf("POLARIS GPU: m0c restored: enable 0x%08x ack 0x%08x req 0x%08x busy 0x%08x\n",
-	    *polaris_m0c_word(gmu, pdc, 0x0b284500ULL), *ack, *req, *busy);
-
-	/*
-	 * status0 bit16 is set whenever GX is off, so "it went back to sleep" only
-	 * means something if the acknowledge had risen first.
-	 */
-	if (acked && idle && slept) {
-		printf("POLARIS GPU: m0c done: PDC ran, GX woke and went back to sleep\n");
-	} else if (!acked) {
-		printf("POLARIS GPU: m0c quarantined: ucode loaded, no acknowledge (sleep check meaningless)\n");
-	} else if (!idle) {
-		printf("POLARIS GPU: m0c quarantined: acknowledged but sequencer still busy\n");
-	} else {
-		printf("POLARIS GPU: m0c quarantined: woke but did not sleep\n");
-	}
-	/* No unmap: same reason as the probe and M0b. */
-}
-
-/* Filled by polaris_gx_readonly_probe(); read by the decision and by M0b. */
-
-/*
- * M1 feasibility, read-only: is the GMU alive at all?
- *
- * PDC-only power-on is closed (m0c section 16) because nothing votes gfx.lvl.
- * The GMU is the other way in: it runs in the CX domain and asks the RSC for GX
- * itself, which is why the vendor calls a6xx_rpmh_power_on_gpu() from the GMU
- * boot path. Before writing anything, three questions can be answered by reads:
- *
- *   - is CX powered (GDSCR status bits, and a slave id that is not all-ones)?
- *   - does the GMU's Cortex-M3 look out of reset (CM3_SYSRESET, CM3_CFG)?
- *   - are the host interrupt registers sane (they should be quiet, not poison)?
- *
- * Everything here is read-only. Offsets are a6xx_reg.h indices converted with the
- * same two window rules as the probe; GX_GDSCR lands on 0x0509100c, the address
- * the bring-up contract already records, which is a useful check on the maths.
- */
-#define POLARIS_GDSCR_CX_PA	0x0509106cULL	/* index 0x2441b, contract +0x106c */
-#define POLARIS_GDSCR_GX_PA	0x0509100cULL	/* index 0x24403, contract +0x100c */
-#define POLARIS_GMU_CM3_SYSRESET_PA	0x0507e000ULL	/* index 0x1F800 */
-#define POLARIS_GMU_CM3_CFG_PA		0x0507e0b4ULL	/* index 0x1F82D */
-#define POLARIS_GMU_PWR_COUNTER_PA	0x0507e100ULL	/* index 0x1F840 */
-#define POLARIS_GMU_GMU2HOST_INFO_PA	0x0507e648ULL	/* index 0x1F992 */
-#define POLARIS_GMU_HOST2GMU_SET_PA	0x0507e650ULL	/* index 0x1F994 */
-#define POLARIS_GMU_AO_INTR_STATUS_PA	0x0508ec14ULL	/* index 0x23B05 */
-#define POLARIS_GMU_AO_AHB_FENCE_PA	0x0508ec40ULL	/* index 0x23B10 */
-
-/* GMU-window read: every address the M1 probe uses is in this window. */
-static uint32_t
-polaris_gmu_rd(vm_offset_t gmu, uint64_t pa)
-{
-	return *(volatile uint32_t *)(uintptr_t)(gmu + (pa - POLARIS_GMU_PA));
-}
-
-static void
-polaris_gx_m1_probe(void)
-{
-	vm_offset_t gmu;
-	uint32_t cx, gx, sysreset, cfg, counter, info, set, aointr, fence;
-
-	gmu = ml_io_map((vm_offset_t)POLARIS_GMU_PA, (vm_size_t)POLARIS_GMU_SIZE);
-	if (gmu == 0) {
-		printf("POLARIS GPU: m1 refused; GMU window map failed\n");
-		return;
-	}
-	cx = polaris_gmu_rd(gmu, POLARIS_GDSCR_CX_PA);
-	gx = polaris_gmu_rd(gmu, POLARIS_GDSCR_GX_PA);
-	sysreset = polaris_gmu_rd(gmu, POLARIS_GMU_CM3_SYSRESET_PA);
-	cfg = polaris_gmu_rd(gmu, POLARIS_GMU_CM3_CFG_PA);
-	counter = polaris_gmu_rd(gmu, POLARIS_GMU_PWR_COUNTER_PA);
-	info = polaris_gmu_rd(gmu, POLARIS_GMU_GMU2HOST_INFO_PA);
-	set = polaris_gmu_rd(gmu, POLARIS_GMU_HOST2GMU_SET_PA);
-	aointr = polaris_gmu_rd(gmu, POLARIS_GMU_AO_INTR_STATUS_PA);
-	fence = polaris_gmu_rd(gmu, POLARIS_GMU_AO_AHB_FENCE_PA);
-
-	printf("POLARIS GPU: m1 gdsc cx 0x%08x gx 0x%08x\n", cx, gx);
-	printf("POLARIS GPU: m1 gmu sysreset 0x%08x cfg 0x%08x counter 0x%08x\n",
-	    sysreset, cfg, counter);
-	printf("POLARIS GPU: m1 gmu intr info 0x%08x set 0x%08x ao 0x%08x fence 0x%08x\n",
-	    info, set, aointr, fence);
-
-	/*
-	 * GDSCR tells the story without guessing: bit0 is the software collapse
-	 * request, and 0x1 in the status field means the domain is off. All-ones on
-	 * a slave read means nothing answered on the bus.
-	 */
-	if (cx == 0xffffffffu || gx == 0xffffffffu) {
-		printf("POLARIS GPU: m1 verdict: GDSCR reads all ones; GPUCC not answering\n");
-	} else if ((cx & 0x1u) != 0 || (gx & 0x1u) != 0) {
-		printf("POLARIS GPU: m1 verdict: a GDSC is collapsed (cx bit0 %u, gx bit0 %u)\n",
-		    cx & 1u, gx & 1u);
-	} else {
-		printf("POLARIS GPU: m1 verdict: both GDSCs out of collapse; GMU block readable\n");
-	}
-	/* No unmap, as everywhere else in this file. */
-}
