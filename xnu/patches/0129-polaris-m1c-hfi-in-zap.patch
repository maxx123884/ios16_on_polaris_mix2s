-/*
- * M1c survey, read-only: is any memory we already own below 4 GiB?
- *
- * The HFI queue table has to be named by a 32-bit register, and this kernel holds no
- * free page under 4 GiB (kalloc: 64 tries high, kmem_alloc_contig: KERN_NO_SPACE). But
- * the shim already placed firmware blobs into memory and advertised them through the
- * ADT, so those ranges are ours and their addresses are known. If one of them lies
- * below 4 GiB there is a place to put a queue table without touching SMMU at all.
- *
- * Prints only: DRAM base and size, then every blob's address with a verdict.
- */
-static void
-polaris_gx_m1c_where(void)
-{
-	struct pg_handoff handoff;
-
-	if (polaris_gpu_read_handoff(&handoff) != PG_OK) {
-		printf("POLARIS GPU: m1c where: ADT read refused\n");
-		return;
-	}
-	printf("POLARIS GPU: m1c where: dram 0x%llx size 0x%llx (4 GiB ceiling 0x100000000)\n",
-	    (unsigned long long)handoff.dram.base, (unsigned long long)handoff.dram.size);
-
-	{
-		unsigned i;
-
-		for (i = 0; i < PG_BLOB_COUNT; i++) {
-			uint64_t base = handoff.blob[i].pa;
-			uint64_t bytes = handoff.blob[i].bytes;
-
-			printf("POLARIS GPU: m1c where: %-12s 0x%llx +0x%llx %s\n",
-			    polaris_gpu_blob_name[i], (unsigned long long)base,
-			    (unsigned long long)bytes,
-			    (base + bytes <= 0x100000000ULL) ? "BELOW 4 GiB" : "above");
-		}
-		printf("POLARIS GPU: m1c where: zap 0x%llx splash 0x%llx\n",
-		    (unsigned long long)handoff.zap.base, (unsigned long long)handoff.splash.base);
-	}
-}
