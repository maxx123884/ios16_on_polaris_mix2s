-/*
- * CPU liveness, read-only.
- *
- * The console ring already shows the shim bringing all eight cores up over PSCI
- * and getting an SGI1 round-trip from each, and the kernel prints "mcache: 8
- * CPU(s)" - but that count comes from the configuration, not from the cores. What
- * proves XNU itself considers a core running is cpu_running, which arm64 sets in
- * cpu.c when the secondary is brought up inside the kernel.
- */
-#if defined(MACH_KERNEL_PRIVATE)
-static void
-polaris_cpu_report(void)
-{
-	unsigned int i, count = ml_get_cpu_count();
-
-	printf("POLARIS GPU: cpu count %u\n", count);
-	for (i = 0; i < count && i < MAX_SCHED_CPUS; i++) {
-		processor_t proc = processor_array[i];
-
-		if (proc == PROCESSOR_NULL) {
-			printf("POLARIS GPU: cpu %u: no processor object\n", i);
-			continue;
-		}
-		printf("POLARIS GPU: cpu %u: cpu_id %d state %d running %u thread %s\n",
-		    i, proc->cpu_id, (int)proc->state,
-		    proc->state == PROCESSOR_RUNNING ? 1u : 0u,
-		    proc->active_thread != THREAD_NULL ? "yes" : "no");
-	}
-}
-#else
-/*
- * processor_array and struct processor are behind MACH_KERNEL_PRIVATE, so the
- * host syntax check cannot see them. The report is pure observation, so it is
- * simply absent there - the kernel build, which is what runs, does compile it.
- */
-static void
-polaris_cpu_report(void)
-{
-	printf("POLARIS GPU: cpu report unavailable in host build\n");
-}
-#endif
-
-/*
- * M1a: what feeds the GPU from outside, before anything is switched on.
- *
- * The dipper port (same SDM845, same A630) walks its GPU up in numbered steps and
- * warns in step 3 that GPUCC must not be touched until gcc_gpu_cfg_ahb_clk is
- * confirmed running - an unclocked access can hang the bus, which is what this
- * port already learned the hard way with the PDC sequencer. So step 1 reads the
- * global clock controller, and step 2 reads GPUCC only if that clock is up.
- *
- * Register offsets follow that port's reading of Linux gcc-sdm845.c and
- * gpucc-sdm845.c; the base addresses are the ones this port already has in the
- * bring-up contract (GPUCC 0x05090000, length 0x9000).
- */
-#define POLARIS_GPUCC_PA	0x05090000ULL	/* GPUCC/GFXCC shared block, contract section 1 */
-#define POLARIS_GPUCC_SIZE	0x00009000ULL
-#define POLARIS_GCC_PA		0x00100000ULL
-#define POLARIS_GCC_SIZE	0x001f0000ULL
-#define POLARIS_GCC_APPS_VOTE0	0x52004u	/* GPLL0 to the GPU sits in here */
-#define POLARIS_GCC_GPU_CFG_AHB	0x71004u
-#define POLARIS_GCC_GPU_MEMNOC	0x7100cu
-#define POLARIS_GCC_GPU_SNOC	0x71018u
-
-#define POLARIS_CBCR_OFF	(1u << 31)	/* branch clock: 1 means the branch is off */
-
-static uint32_t
-polaris_reg_rd(vm_offset_t base, uint32_t off)
-{
-	return *(volatile uint32_t *)(uintptr_t)(base + off);
-}
-
-/*
- * M1a step 3: close the CX power switch, the way Linux's gdsc.c does it for
- * gpu_cx_gdsc (VOTABLE): set the clock-disable wait in GDSCR, clear SW_COLLAPSE,
- * then wait for the power-on bit in the hardware-control register. The dipper
- * port does exactly this and reads the same two registers.
- *
- * Reversible on purpose: the GDSCR value is snapshotted and written back, and the
- * hardware-control bit is re-read to confirm the switch fell again. A switch that
- * goes on and will not come off is the outcome that ends the GPU line here.
- */
-#define POLARIS_GPUCC_CX_GDSCR		0x106cu
-#define POLARIS_GPUCC_CX_HWCTRL		0x1540u
-#define POLARIS_GDSCR_SW_COLLAPSE	(1u << 0)
-#define POLARIS_GDSCR_CLK_DIS_WAIT	(0xfu << 12)
-#define POLARIS_CX_CLK_DIS_WAIT_VAL	8u	/* qcom,clk-dis-wait-val of the GPU CC node */
-#define POLARIS_GDSC_PWR_ON		(1u << 31)
-#define POLARIS_GDSC_POLL_US		2000u
-
-static void
-polaris_reg_wr(vm_offset_t base, uint32_t off, uint32_t value)
-{
-	*(volatile uint32_t *)(uintptr_t)(base + off) = value;
-#if defined(__aarch64__)
-	__asm__ volatile ("dsb sy" ::: "memory");
-#endif
-}
-
-static bool
-polaris_cx_wait(vm_offset_t gpucc, bool on)
-{
-	uint32_t waited;
-
-	for (waited = 0; waited <= POLARIS_GDSC_POLL_US; waited += 10) {
-		bool now = (polaris_reg_rd(gpucc, POLARIS_GPUCC_CX_HWCTRL) & POLARIS_GDSC_PWR_ON) != 0;
-
-		if (now == on) {
-			return true;
-		}
-		delay(10);
-	}
-	return false;
-}
-
-static void
-polaris_gx_m1a_cx(vm_offset_t gpucc)
-{
-	uint32_t before = polaris_reg_rd(gpucc, POLARIS_GPUCC_CX_GDSCR);
-	uint32_t v;
-	bool on;
-
-	printf("POLARIS GPU: m1a cx before: gdscr 0x%08x hw_ctrl 0x%08x\n",
-	    before, polaris_reg_rd(gpucc, POLARIS_GPUCC_CX_HWCTRL));
-	if ((polaris_reg_rd(gpucc, POLARIS_GPUCC_CX_HWCTRL) & POLARIS_GDSC_PWR_ON) != 0) {
-		printf("POLARIS GPU: m1a cx: already powered on, not touched\n");
-		return;
-	}
-
-	/* gdsc_init(): program the clock-disable wait, then toggle the switch on. */
-	v = before & ~POLARIS_GDSCR_CLK_DIS_WAIT;
-	printf("POLARIS GPU: m1a cx write gdscr 0x%08x (clk-dis-wait %u)\n",
-	    v | (POLARIS_CX_CLK_DIS_WAIT_VAL << 12), POLARIS_CX_CLK_DIS_WAIT_VAL);
-	delay(1300000);	/* let the ring keep the line before the store */
-	polaris_reg_wr(gpucc, POLARIS_GPUCC_CX_GDSCR,
-	    v | (POLARIS_CX_CLK_DIS_WAIT_VAL << 12));
-
-	v = polaris_reg_rd(gpucc, POLARIS_GPUCC_CX_GDSCR);
-	printf("POLARIS GPU: m1a cx write gdscr 0x%08x (collapse cleared)\n",
-	    v & ~POLARIS_GDSCR_SW_COLLAPSE);
-	delay(1300000);
-	polaris_reg_wr(gpucc, POLARIS_GPUCC_CX_GDSCR, v & ~POLARIS_GDSCR_SW_COLLAPSE);
-
-	delay(1);
-	on = polaris_cx_wait(gpucc, true);
-	printf("POLARIS GPU: m1a cx after: gdscr 0x%08x hw_ctrl 0x%08x: %s\n",
-	    polaris_reg_rd(gpucc, POLARIS_GPUCC_CX_GDSCR),
-	    polaris_reg_rd(gpucc, POLARIS_GPUCC_CX_HWCTRL),
-	    on ? "power ON" : "STILL OFF after 2 ms");
-
-	/* Put it back: this step answers a question, it does not keep a domain on. */
-	printf("POLARIS GPU: m1a cx restore gdscr 0x%08x\n", before);
-	delay(1300000);
-	polaris_reg_wr(gpucc, POLARIS_GPUCC_CX_GDSCR, before);
-	delay(1);
-	if (on) {
-		bool off = polaris_cx_wait(gpucc, false);
-
-		printf("POLARIS GPU: m1a cx restored: hw_ctrl 0x%08x: %s\n",
-		    polaris_reg_rd(gpucc, POLARIS_GPUCC_CX_HWCTRL),
-		    off ? "switch fell again" : "STILL ON - we own power-on but not power-off");
-	} else {
-		printf("POLARIS GPU: m1a cx restored: hw_ctrl 0x%08x (never went on)\n",
-		    polaris_reg_rd(gpucc, POLARIS_GPUCC_CX_HWCTRL));
-	}
-}
-
-/*
- * M1a step 4: with CX powered, bring up its clocks and ask the GMU whether it is
- * alive. The clock order and the register semantics are the dipper port's step 5:
- * enable the two GCC branches, program the GMU clock source (crystal, undivided),
- * then the GMU's own branch - each verified by its status bit, not assumed.
- *
- * The verdict is the always-on counter at GMU word 0x5088. It is hardware-driven,
- * so it needs no understanding of the firmware: if it moves, the GMU is running.
- * Everything is undone in reverse and re-read, CX included.
- */
-#define POLARIS_GPUCC_GMU_RCG_CMD	0x1120u
-#define POLARIS_GPUCC_GMU_RCG_CFG	0x1124u
-#define POLARIS_GPUCC_CX_GMU_CBCR	0x1098u
-#define POLARIS_GPUCC_CXO_CBCR		0x109cu
-#define POLARIS_CBCR_ENABLE		(1u << 0)
-#define POLARIS_RCG_UPDATE		(1u << 0)
-#define POLARIS_RCG_ROOT_EN		(1u << 1)
-#define POLARIS_RCG_ROOT_OFF		(1u << 31)
-#define POLARIS_GMU_COUNTER_WORD	0x5088u
-#define POLARIS_GMU_PA			0x0506a000ULL
-
-static bool
-polaris_branch_on(vm_offset_t base, uint32_t off, const char *name)
-{
-	uint32_t waited;
-
-	polaris_reg_wr(base, off, polaris_reg_rd(base, off) | POLARIS_CBCR_ENABLE);
-	for (waited = 0; waited <= 1000; waited += 5) {
-		if ((polaris_reg_rd(base, off) & POLARIS_CBCR_OFF) == 0) {
-			printf("POLARIS GPU: m1a clk %s on: 0x%08x\n", name, polaris_reg_rd(base, off));
-			return true;
-		}
-		delay(5);
-	}
-	printf("POLARIS GPU: m1a clk %s does not come on: 0x%08x\n", name,
-	    polaris_reg_rd(base, off));
-	return false;
-}
-
-/*
- * M1b: ask the GMU how far it got, read-only.
- *
- * The ITCM test showed real instruction words already in place, so the firmware was
- * staged before this port ran - which means the useful question is no longer "can we
- * load it" but "did it ever run". These are the registers that answer it, at the word
- * offsets the dipper port and a6xx_gmu.xml agree on.
- */
-static void
-polaris_gx_m1b_state(vm_offset_t gmuwin)
-{
-	static const struct {
-		const char *name;
-		uint32_t word;
-	} regs[] = {
-		{ "CM3_SYSRESET", 0x5000 },
-		{ "CM3_BOOT_CONFIG", 0x5001 },
-		{ "CM3_FW_INIT_RESULT", 0x501c },
-		{ "HFI_SFR_ADDR", 0x5182 },
-		{ "HFI_QTBL_INFO", 0x5184 },
-		{ "HFI_QTBL_ADDR", 0x5185 },
-		{ "HFI_CTRL_STATUS", 0x5180 },
-		{ "HFI_CTRL_INIT", 0x5186 },
-	};
-	unsigned i;
-	uint32_t fw = 0, hfi = 0;
-
-	for (i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
-		uint32_t v = *(volatile uint32_t *)(uintptr_t)(gmuwin + regs[i].word * 4u);
-
-		if (regs[i].word == 0x501cu) {
-			fw = v;
-		}
-		if (regs[i].word == 0x5180u) {
-			hfi = v;
-		}
-		printf("POLARIS GPU: m1b %-18s 0x%08x\n", regs[i].name, v);
-	}
-	printf("POLARIS GPU: m1b verdict: fw_init_result 0x%08x (%s), hfi_status 0x%08x (%s)\n",
-	    fw, fw != 0 ? "non-zero" : "zero",
-	    hfi, hfi != 0 ? "non-zero" : "zero");
-}
-
-/*
- * M1b step 11: let the CM3 out of reset.
- *
- * Read-only evidence says the firmware is staged in ITCM but the core is held with
- * SYSRESET bit0 set, so FW_INIT_RESULT is zero and no HFI queue was ever built. Two
- * writes turn that around: the boot configuration (0x2, the value the dipper port
- * uses) and then clearing the reset bit. Both are put back afterwards - the reset is
- * asserted again and the configuration restored - so a failed attempt leaves the GPU
- * exactly as XBL handed it over.
- *
- * The always-on counter keeps running either way: it lives in the AON domain and is
- * driven by CXO, so it says the block is powered and clocked, not that the CM3 runs.
- */
-#define POLARIS_GMU_SYSRESET	0x5000u
-#define POLARIS_GMU_BOOTCFG	0x5001u
-#define POLARIS_GMU_FWINIT	0x501cu
-#define POLARIS_GMU_HFISTATUS	0x5180u
-
-static void
-polaris_gx_m1b_boot(vm_offset_t gmuwin)
-{
-	uint32_t sr_before = *(volatile uint32_t *)(uintptr_t)(gmuwin + POLARIS_GMU_SYSRESET * 4u);
-	uint32_t bc_before = *(volatile uint32_t *)(uintptr_t)(gmuwin + POLARIS_GMU_BOOTCFG * 4u);
-	uint32_t fw = 0, waited;
-	bool ran = false;
-
-	printf("POLARIS GPU: m1b boot before: sysreset 0x%08x bootcfg 0x%08x\n",
-	    sr_before, bc_before);
-	if ((sr_before & 1u) == 0) {
-		printf("POLARIS GPU: m1b boot: reset is already released, not touched\n");
-		return;
-	}
-
-	printf("POLARIS GPU: m1b boot write bootcfg 0x%08x\n", 0x2u);
-	delay(1300000);
-	*(volatile uint32_t *)(uintptr_t)(gmuwin + POLARIS_GMU_BOOTCFG * 4u) = 0x2u;
-#if defined(__aarch64__)
-	__asm__ volatile ("dsb sy" ::: "memory");
-#endif
-
-	printf("POLARIS GPU: m1b boot release reset (sysreset 0x%08x)\n", sr_before & ~1u);
-	delay(1300000);
-	*(volatile uint32_t *)(uintptr_t)(gmuwin + POLARIS_GMU_SYSRESET * 4u) = sr_before & ~1u;
-#if defined(__aarch64__)
-	__asm__ volatile ("dsb sy" ::: "memory");
-#endif
-
-	/* give the firmware a moment, then look */
-	for (waited = 0; waited <= 50000; waited += 500) {
-		fw = *(volatile uint32_t *)(uintptr_t)(gmuwin + POLARIS_GMU_FWINIT * 4u);
-		if (fw != 0) {
-			ran = true;
-			break;
-		}
-		delay(500);
-	}
-	printf("POLARIS GPU: m1b boot after: sysreset 0x%08x bootcfg 0x%08x fw_init 0x%08x hfi 0x%08x: %s\n",
-	    *(volatile uint32_t *)(uintptr_t)(gmuwin + POLARIS_GMU_SYSRESET * 4u),
-	    *(volatile uint32_t *)(uintptr_t)(gmuwin + POLARIS_GMU_BOOTCFG * 4u),
-	    fw, *(volatile uint32_t *)(uintptr_t)(gmuwin + POLARIS_GMU_HFISTATUS * 4u),
-	    ran ? "FW_INIT non-zero - the CM3 ran" : "FW_INIT still zero after 50 ms");
-
-	/* put it back the way XBL left it */
-	printf("POLARIS GPU: m1b boot restore sysreset 0x%08x bootcfg 0x%08x\n",
-	    sr_before, bc_before);
-	delay(1300000);
-	*(volatile uint32_t *)(uintptr_t)(gmuwin + POLARIS_GMU_SYSRESET * 4u) = sr_before;
-	delay(1300000);
-	*(volatile uint32_t *)(uintptr_t)(gmuwin + POLARIS_GMU_BOOTCFG * 4u) = bc_before;
-	delay(1);
-	printf("POLARIS GPU: m1b boot restored: sysreset 0x%08x bootcfg 0x%08x\n",
-	    *(volatile uint32_t *)(uintptr_t)(gmuwin + POLARIS_GMU_SYSRESET * 4u),
-	    *(volatile uint32_t *)(uintptr_t)(gmuwin + POLARIS_GMU_BOOTCFG * 4u));
-}
-
-/*
- * M1c survey, read-only: what state is the GPU's SMMU in?
- *
- * Releasing the CM3 hung the machine, most plausibly because the firmware touched
- * memory for which no address space exists. Before building one, read what is there:
- * whether translation is on, which stream-to-context entries are programmed and what
- * the first context bank is set to. The layout is the ARM SMMU v2 one the dipper port
- * uses (global space 0 at 0x05040000, context attributes from 0x1000).
- */
-#define POLARIS_SMMU_PA		0x05040000ULL
-#define POLARIS_SMMU_SIZE	0x00010000ULL
-#define POLARIS_SMMU_SCR0	0x000u
-#define POLARIS_SMMU_SACR	0x010u
-#define POLARIS_SMMU_ID0	0x020u
-#define POLARIS_SMMU_ID1	0x024u
-#define POLARIS_SMMU_SGFSR	0x048u
-#define POLARIS_SMMU_CB0_SCTLR	0x1000u
-
-static void
-polaris_gx_m1c_smmu(void)
-{
-	vm_offset_t smmu = ml_io_map((vm_offset_t)POLARIS_SMMU_PA, (vm_size_t)POLARIS_SMMU_SIZE);
-	uint32_t scr0, smr, s2cr;
-
-	if (smmu == 0) {
-		printf("POLARIS GPU: m1c smmu window map failed\n");
-		return;
-	}
-	scr0 = polaris_reg_rd(smmu, POLARIS_SMMU_SCR0);
-	printf("POLARIS GPU: m1c smmu: id0 0x%08x id1 0x%08x scr0 0x%08x (%s) sacr 0x%08x sgfsr 0x%08x\n",
-	    polaris_reg_rd(smmu, POLARIS_SMMU_ID0), polaris_reg_rd(smmu, POLARIS_SMMU_ID1),
-	    scr0, (scr0 & 1u) ? "TRANSLATION ON" : "translation off",
-	    polaris_reg_rd(smmu, POLARIS_SMMU_SACR), polaris_reg_rd(smmu, POLARIS_SMMU_SGFSR));
-	smr = polaris_reg_rd(smmu, 0x800u);	/* SMR0: stream match for the GPU */
-	s2cr = polaris_reg_rd(smmu, 0xc00u);	/* S2CR0: which context bank */
-	printf("POLARIS GPU: m1c smmu: smr0 0x%08x s2cr0 0x%08x (type %u, cb %u) cb0_sctlr 0x%08x\n",
-	    smr, s2cr, (s2cr >> 2) & 0x3u, s2cr & 0xfu,
-	    polaris_reg_rd(smmu, POLARIS_SMMU_CB0_SCTLR));
-	printf("POLARIS GPU: m1c smmu: cb0_ttbr0 0x%08x cb0_tcr 0x%08x cb0_fsr 0x%08x\n",
-	    polaris_reg_rd(smmu, 0x1020u), polaris_reg_rd(smmu, 0x1030u),
-	    polaris_reg_rd(smmu, 0x1058u));
-}
-
-/*
- * M1c, first half: give the GMU something to talk to, without waking it.
- *
- * The last attempt cleared SYSRESET with both HFI address registers at zero, and the
- * machine died - the firmware went looking for queues at physical zero. So the order is
- * preparation first: one page of physically contiguous memory holding the queue table
- * and its two queue headers, then the addresses in HFI_QTBL_ADDR and HFI_SFR_ADDR, then
- * read the whole thing back. The CM3 stays in reset throughout, so a wrong layout here
- * costs a reboot only if we later choose to release - not now.
- *
- * Layout is the a6xx one: a 24-byte table header, two 48-byte queue headers, queue 0
- * host to GMU and queue 1 GMU to host, followed by their buffers.
- */
-#define POLARIS_HFI_PAGE	4096u
-#define POLARIS_HFI_QTBL_INFO	0x5184u
-#define POLARIS_HFI_QTBL_ADDR	0x5185u
-#define POLARIS_HFI_SFR_ADDR	0x5182u
-
-struct polaris_hfi_table_hdr {
-	uint32_t version;
-	uint32_t size;
-	uint32_t qhdr0_offset;
-	uint32_t qhdr1_offset;
-	uint32_t qhdr0_size;
-	uint32_t qhdr1_size;
-} __attribute__((packed));
-
-struct polaris_hfi_queue_hdr {
-	uint32_t status;
-	uint32_t start_addr;
-	uint32_t type;
-	uint32_t queue_size;
-	uint32_t msg_size;
-	uint32_t drop_counter;
-	uint32_t rx_watermark;
-	uint32_t tx_watermark;
-	uint32_t rx_request;
-	uint32_t tx_request;
-	uint32_t read_index;
-	uint32_t write_index;
-} __attribute__((packed));
-
-struct polaris_hfi_blob {
-	struct polaris_hfi_table_hdr table;
-	struct polaris_hfi_queue_hdr q[2];
-	uint8_t host_to_gmu[1536];
-	uint8_t gmu_to_host[1536];
-} __attribute__((packed));
-
-static void
-polaris_gx_m1c_hfi(vm_offset_t gmuwin)
-{
-	static struct polaris_hfi_blob *blob;
-	static vm_offset_t va;
-#if defined(KERNEL_PRIVATE)
-	kern_return_t kr;
-#endif
-	uint64_t pa;
-	uint32_t before_info, before_tbl, before_sfr;
-
-	if (blob == NULL) {
-		/*
-		 * One page: a single kalloc page is physically contiguous by construction.
-		 * HFI_QTBL_ADDR is 32 bits wide, so the page must also sit below 4 GiB -
-		 * a physical address above that arrives truncated and the GMU would look
-		 * for the table at the wrong place, which is a good way to hang the bus.
-		 * The first page handed out was at 0x1_02e30000, hence the retry loop.
-		 */
-#if defined(KERNEL_PRIVATE)
-		/*
-		 * kalloc never produced a page below 4 GiB (64 tries, all above), because the
-		 * free pool sits high. kmem_alloc_contig can be told the ceiling, which is the
-		 * only way to satisfy a 32-bit register. Declared through the private headers,
-		 * so this branch only exists in the real kernel build.
-		 */
-		kr = kmem_alloc_contig(kernel_map, &va, POLARIS_HFI_PAGE, PAGE_MASK, 0,
-		    0xFFFFFFFFULL, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT);
-		if (kr != KERN_SUCCESS) {
-			printf("POLARIS GPU: m1c hfi: no page below 4 GiB (kmem_alloc_contig 0x%x)\n", kr);
-			return;
-		}
-		blob = (struct polaris_hfi_blob *)(uintptr_t)va;
-#else
-		printf("POLARIS GPU: m1c hfi: low-memory allocation is not visible to the host check\n");
-		return;
-#endif
-	}
-
-	{
-		unsigned int pn = pmap_find_phys(pmap_kernel(), (uint64_t)va);
-
-		if (pn == 0) {
-			printf("POLARIS GPU: m1c hfi: no physical page for 0x%llx\n",
-			    (unsigned long long)va);
-			return;
-		}
-		pa = (uint64_t)pn << PAGE_SHIFT;
-	}
-	printf("POLARIS GPU: m1c hfi: va 0x%llx pa 0x%llx (%u bytes, contiguous by allocation)\n",
-	    (unsigned long long)va, (unsigned long long)pa, POLARIS_HFI_PAGE);
-
-	/* table header */
-	blob->table.version = 0;
-	blob->table.size = sizeof(struct polaris_hfi_table_hdr) + 2u * sizeof(struct polaris_hfi_queue_hdr);
-	blob->table.qhdr0_offset = sizeof(struct polaris_hfi_table_hdr);
-	blob->table.qhdr0_size = sizeof(struct polaris_hfi_queue_hdr);
-	blob->table.qhdr1_offset = blob->table.qhdr0_offset + blob->table.qhdr0_size;
-	blob->table.qhdr1_size = sizeof(struct polaris_hfi_queue_hdr);
-
-	/* queue 0: host to GMU, queue 1: GMU to host; addresses are physical */
-	blob->q[0].status = 1u;
-	blob->q[0].start_addr = (uint32_t)(pa + offsetof(struct polaris_hfi_blob, host_to_gmu));
-	blob->q[0].type = 0u;
-	blob->q[0].queue_size = sizeof(blob->host_to_gmu);
-	blob->q[0].msg_size = sizeof(blob->host_to_gmu);
-	blob->q[0].rx_watermark = sizeof(blob->host_to_gmu) / 4u;
-	blob->q[0].tx_watermark = sizeof(blob->host_to_gmu) / 4u;
-	blob->q[0].read_index = 0;
-	blob->q[0].write_index = 0;
-
-	blob->q[1].status = 1u;
-	blob->q[1].start_addr = (uint32_t)(pa + offsetof(struct polaris_hfi_blob, gmu_to_host));
-	blob->q[1].type = 1u;
-	blob->q[1].queue_size = sizeof(blob->gmu_to_host);
-	blob->q[1].msg_size = sizeof(blob->gmu_to_host);
-	blob->q[1].rx_watermark = sizeof(blob->gmu_to_host) / 4u;
-	blob->q[1].tx_watermark = sizeof(blob->gmu_to_host) / 4u;
-
-	printf("POLARIS GPU: m1c hfi: table size %u hdr0@%u hdr1@%u q0.start 0x%08x q1.start 0x%08x\n",
-	    blob->table.size, blob->table.qhdr0_offset, blob->table.qhdr1_offset,
-	    blob->q[0].start_addr, blob->q[1].start_addr);
-
-	before_info = polaris_reg_rd(gmuwin, POLARIS_HFI_QTBL_INFO * 4u);
-	before_tbl = polaris_reg_rd(gmuwin, POLARIS_HFI_QTBL_ADDR * 4u);
-	before_sfr = polaris_reg_rd(gmuwin, POLARIS_HFI_SFR_ADDR * 4u);
-	printf("POLARIS GPU: m1c hfi regs before: info 0x%08x tbl 0x%08x sfr 0x%08x\n",
