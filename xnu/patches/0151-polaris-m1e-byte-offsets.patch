+
+/* The vendor headers give byte offsets; polaris_reg_rd/wr multiply by four because the
+ * constants this port grew up with were dword indices. Mixing the two walks off the end
+ * of the mapped window - 0x1F800 became 0x7E000 - and that is a bus error, not a wrong
+ * value, which is why the machine died without printing anything. */
+static uint32_t
+polaris_reg_rd_b(vm_offset_t win, uint32_t byte_off)
+{
+	return *(volatile uint32_t *)(uintptr_t)(win + byte_off);
+}
+
+static void
+polaris_reg_wr_b(vm_offset_t win, uint32_t byte_off, uint32_t val)
+{
+	*(volatile uint32_t *)(uintptr_t)(win + byte_off) = val;
+}
+
