+	 * printed once already.
+	 */
+	if (acked) {
+		for (i = 0; i < POLARIS_M0C_WAIT_MS; i++) {
+			delay(1000);
+			if ((*status0 & (1u << 16)) != 0) {
+				slept = true;
+				break;
+			}
 		}
+		printf("POLARIS GPU: m0c sleep status0 0x%08x after %u ms\n",
+		    *status0, (unsigned)(i + 1));
+	} else {
