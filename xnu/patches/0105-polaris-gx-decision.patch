--- a/bsd/dev/polaris_gpu_validate.h
+++ b/bsd/dev/polaris_gpu_validate.h
@@ -133,4 +133,38 @@
 pg_validate_handoff(const struct pg_handoff *handoff,
     const struct pg_expect *expect, struct pg_validate_result *result);
 
+/*
+ * Phase 3: what the measured GX state permits. Pure, like phase 1 and 2 - the
+ * caller passes the nine words that polaris_gx_readonly_probe() read, and this
+ * returns the only action that state authorises. It is the single place
+ * allowed to say "a write to GMU_RSCC_CONTROL_REQ is permitted", so a refusal
+ * here must leave the CPU framebuffer and the 0090 touch path alone.
+ *
+ * The matrix is m0a-gx-readonly-probe.zh-CN.md section 3; the measured values
+ * from the phone are in section 11.
+ */
+#define PG_GX_BIT_ON		0x2u	/* bit1 of RSCC_CONTROL_{REQ,ACK} */
+#define PG_GX_PDC_SEQ_START	0x4520u	/* vendor PDC program, measured */
+
+struct pg_gx_state {
+	bool     firmware_proven;
+	uint32_t control_ack;	/* GMU_RSCC_CONTROL_ACK */
+	uint32_t control_req;	/* GMU_RSCC_CONTROL_REQ */
+	uint32_t seq_busy;	/* RSCC_SEQ_BUSY_DRV0 */
+	uint32_t pdc_enable;	/* PDC_GPU_ENABLE_PDC */
+	uint32_t seq_start;	/* RSCC_PDC_SEQ_START_ADDR */
+};
+
+enum pg_gx_action {
+	PG_GX_WRITE_REQ = 0,	/* off, idle, vendor PDC program in place, proven */
+	PG_GX_REFUSE_UNPROVEN,	/* digests never matched: no MMIO at all */
+	PG_GX_REFUSE_SEQ_BUSY,	/* someone else is running a sequence */
+	PG_GX_REFUSE_INCONSISTENT,	/* REQ without ACK, or ACK without REQ */
+	PG_GX_REFUSE_ALREADY_ON,	/* already powered: writing REQ again is wrong */
+	PG_GX_REFUSE_NO_PDC	/* the 0x4520 program is not there */
+};
+
+enum pg_gx_action pg_gx_decide(const struct pg_gx_state *state);
+const char *pg_gx_action_name(enum pg_gx_action action);
+
 #endif /* _BSD_DEV_POLARIS_GPU_VALIDATE_H_ */
--- a/bsd/dev/polaris_gpu_validate.c
+++ b/bsd/dev/polaris_gpu_validate.c
@@ -247,3 +247,58 @@
 	}
 	return pg_validate_digests(handoff, expect);
 }
+
+/*
+ * The GX decision. Order matters and is the matrix's: an unproven handoff never
+ * reaches MMIO, a busy sequencer stops everything, and a request that disagrees
+ * with its acknowledge is a state we do not understand well enough to add to.
+ */
+enum pg_gx_action
+pg_gx_decide(const struct pg_gx_state *state)
+{
+	bool ack, req;
+
+	if (state == NULL) {
+		return PG_GX_REFUSE_UNPROVEN;
+	}
+	if (!state->firmware_proven) {
+		return PG_GX_REFUSE_UNPROVEN;
+	}
+	if (state->seq_busy != 0) {
+		return PG_GX_REFUSE_SEQ_BUSY;
+	}
+	ack = (state->control_ack & PG_GX_BIT_ON) != 0;
+	req = (state->control_req & PG_GX_BIT_ON) != 0;
+	if (ack != req) {
+		return PG_GX_REFUSE_INCONSISTENT;
+	}
+	if (ack) {
+		return PG_GX_REFUSE_ALREADY_ON;
+	}
+	if (state->seq_start != PG_GX_PDC_SEQ_START) {
+		return PG_GX_REFUSE_NO_PDC;
+	}
+	return PG_GX_WRITE_REQ;
+}
+
+const char *
+pg_gx_action_name(enum pg_gx_action action)
+{
+	switch (action) {
+	case PG_GX_WRITE_REQ:
+		return "write RSCC_CONTROL_REQ allowed";
+	case PG_GX_REFUSE_UNPROVEN:
+		return "refused: firmware not proven";
+	case PG_GX_REFUSE_SEQ_BUSY:
+		return "refused: sequencer busy";
+	case PG_GX_REFUSE_INCONSISTENT:
+		return "refused: REQ/ACK disagree";
+	case PG_GX_REFUSE_ALREADY_ON:
+		return "refused: GX already powered";
+	case PG_GX_REFUSE_NO_PDC:
+		return "refused: vendor PDC program missing";
+	default:
+		break;
+	}
+	return "refused: unknown state";
+}
