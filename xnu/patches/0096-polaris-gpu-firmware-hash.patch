-pg_validate_handoff(const struct pg_handoff *handoff,
+pg_validate_layout(const struct pg_handoff *handoff,
     const struct pg_expect *expect, struct pg_validate_result *result)
 {
 	uint64_t dram_end, zap_end, splash_end, mapped = 0;
@@ -199,6 +200,23 @@ pg_validate_handoff(const struct pg_handoff *handoff,
 		mapped += reserve;
 	}
 
+	result->blobs_ok = PG_BLOB_COUNT;
+	result->mapped_bytes = mapped;
+	return PG_OK;
+}
+
+enum pg_status
+pg_validate_digests(const struct pg_handoff *handoff,
+    const struct pg_expect *expect)
+{
+	uint32_t i;
+
+	if (handoff == NULL || expect == NULL) {
+		return PG_EINVAL;
+	}
+	if (!pg_expect_complete(expect, PG_BLOB_COUNT)) {
+		return PG_EHASH_UNPROVEN;
+	}
 	/*
 	 * Layout alone never authorises firmware: the digests must be proven.
 	 * A zero digest in the handoff means these bytes were never hashed by
@@ -214,8 +232,18 @@ pg_validate_handoff(const struct pg_handoff *handoff,
 			return PG_EHASH_MISMATCH;
 		}
 	}
-
-	result->blobs_ok = PG_BLOB_COUNT;
-	result->mapped_bytes = mapped;
 	return PG_OK;
 }
+
+enum pg_status
+pg_validate_handoff(const struct pg_handoff *handoff,
+    const struct pg_expect *expect, struct pg_validate_result *result)
+{
+	enum pg_status status;
+
+	status = pg_validate_layout(handoff, expect, result);
+	if (status != PG_OK) {
+		return status;
+	}
+	return pg_validate_digests(handoff, expect);
+}
