- * unproven is treated as failure everywhere else in this contract.
+ * True when EXPECT carries a size and a non-zero digest for every blob. A
+ * partially filled table is never "good enough": unproven is treated as
+ * failure everywhere else in this contract.
  */
 bool
 pg_expect_complete(const struct pg_expect *expect, size_t count);
 
 /*
- * Validate the handoff. Pure function: the inputs are never written, and
- * RESULT is only written on PG_OK.
+ * Phase 1: ranges only. Proves the ADT layout is the pinned set, page aligned,
+ * inside XNU-managed DRAM, clear of the PAS13 carveout and the ABL splash, and
+ * non-overlapping. Digests are NOT inspected. Pure function: inputs are never
+ * written, RESULT is only written on PG_OK.
+ *
+ * This is the phase a caller may run before it has any way to hash memory, so
+ * a missing hash backend cannot be mistaken for a bad firmware layout.
+ */
+enum pg_status
+pg_validate_layout(const struct pg_handoff *handoff,
+    const struct pg_expect *expect, struct pg_validate_result *result);
+
+/*
+ * Phase 2: digests only. Returns PG_EHASH_UNPROVEN when the handoff carries a
+ * zero digest (these bytes were never hashed), PG_EHASH_MISMATCH when a digest
+ * was computed and disagrees. It does not re-check ranges.
+ */
+enum pg_status
+pg_validate_digests(const struct pg_handoff *handoff,
+    const struct pg_expect *expect);
+
+/*
+ * Both phases, in order: layout, then digests. Pure function, same contract as
+ * pg_validate_layout() plus the digest requirement.
  */
 enum pg_status
 pg_validate_handoff(const struct pg_handoff *handoff,
diff --git a/tools/hosthash/harness.c b/tools/hosthash/harness.c
new file mode 100644
index 0000000..103f790
--- /dev/null
+++ b/tools/hosthash/harness.c
@@ -0,0 +1,193 @@
+/*
+ * Host harness for bsd/dev/polaris_gpu_hash.c.
+ *
+ * The kernel file cannot be linked on a host (no ml_io_map, no libkern), so
+ * this harness supplies stubs and then checks the one thing that is easy to
+ * get wrong and impossible to see by reading: that the Device-memory copy
+ * reproduces the source bytes exactly, for the six real firmware sizes and for
+ * a deliberately unaligned tail.
+ *
+ * SHA-256 is stubbed out on purpose. Its correctness is XNU's problem (0023);
+ * this test covers our copy loop only.
+ */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <sys/param.h>
+#include <mach/vm_types.h>
+#include <libkern/crypto/sha2.h>
+
+#include "polaris_gpu_hash.h"
+
+/* ---- stubs ------------------------------------------------------------- */
+
+static uint8_t g_sink[1u << 20];
+static size_t g_sink_len;
+
+void
+SHA256_Init(SHA256_CTX *ctx)
+{
+	/*
+	 * Deliberately does NOT reset g_sink_len: the kernel calls Init once per
+	 * blob, and this harness needs one continuous record to prove that each
+	 * blob's bytes arrive intact at the hash function.
+	 */
+	(void)ctx;
+}
+
+void
+SHA256_Update(SHA256_CTX *ctx, const void *data, size_t len)
+{
+	(void)ctx;
+	if (g_sink_len + len > sizeof(g_sink)) {
+		printf("FAIL: sink overflow\n");
+		exit(1);
+	}
+	memcpy(g_sink + g_sink_len, data, len);
+	g_sink_len += len;
+}
+
+void
+SHA256_Final(void *digest, SHA256_CTX *ctx)
+{
+	(void)ctx;
+	memset(digest, 0xa5, PG_HASH_BYTES);
+}
+
+/* Identity mapping: this harness stores "physical" addresses as pointers. */
+vm_offset_t
+ml_io_map(vm_offset_t phys_addr, vm_size_t size)
+{
+	(void)size;
+	return phys_addr;
+}
+
+/* ---- test -------------------------------------------------------------- */
+
+static unsigned int failures;
+
+#define CHECK(cond) do {						\
+	if (!(cond)) {							\
+		printf("FAIL %d: %s\n", __LINE__, #cond);		\
+		failures++;						\
+	}								\
+} while (0)
+
+/* The six sizes of the pinned MIUI 12.5.1 set, in enum pg_blob_id order. */
+static const uint64_t pinned[PG_BLOB_COUNT] = {
+	31980, 32768, 6684, 148, 6536, 1968
+};
+
+static void
+fill(uint8_t *p, size_t n, unsigned int seed)
+{
+	size_t i;
+
+	for (i = 0; i < n; ++i) {
+		p[i] = (uint8_t)((i * 31u + seed * 17u) & 0xffu);
+	}
+}
+
+static void
+run_case(const uint64_t *sizes, const char *label)
+{
+	struct pg_handoff handoff;
+	uint8_t *src[PG_BLOB_COUNT];
+	size_t base = g_sink_len;	/* this run starts where the last ended */
+	uint32_t i;
+
+	memset(&handoff, 0, sizeof(handoff));
+	for (i = 0; i < PG_BLOB_COUNT; ++i) {
+		src[i] = malloc((size_t)sizes[i]);
+		CHECK(src[i] != NULL);
+		if (src[i] == NULL) {
+			return;
+		}
+		fill(src[i], (size_t)sizes[i], i);
+		handoff.blob[i].pa = (uint64_t)(uintptr_t)src[i];
+		handoff.blob[i].bytes = sizes[i];
+	}
+
+	CHECK(polaris_gpu_hash_handoff(&handoff) == PG_OK);
+
+	/* Each blob is hashed in order, so the sink must be the concatenation. */
+	{
+		size_t at = 0;
+
+		for (i = 0; i < PG_BLOB_COUNT; ++i) {
+			size_t n = (size_t)sizes[i];
+
+			CHECK(g_sink_len >= base + at + n);
+			if (memcmp(g_sink + base + at, src[i], n) != 0) {
+				size_t j;
+
+				for (j = 0; j < n; ++j) {
+					if (g_sink[base + at + j] != src[i][j]) {
+						printf("FAIL %s: blob %u differs at %zu "
+						    "(sink %zu, want %zu)\n",
+						    label, i, j, g_sink_len, at + n);
+						break;
+					}
+				}
+				failures++;
+			}
+			at += n;
+		}
+		CHECK(g_sink_len == base + at);
+	}
+	for (i = 0; i < PG_BLOB_COUNT; ++i) {
+		CHECK(!(handoff.blob[i].sha256[0] == 0 &&
+		    handoff.blob[i].sha256[1] == 0));
+	}
+
+	for (i = 0; i < PG_BLOB_COUNT; ++i) {
+		free(src[i]);
+	}
+}
+
+int
+main(void)
+{
+	uint64_t tail[PG_BLOB_COUNT];
+	uint32_t i;
+
+	run_case(pinned, "pinned set");
+
+	/* One byte, then three: the word loop must stop and the tail take over. */
+	for (i = 0; i < PG_BLOB_COUNT; ++i) {
+		tail[i] = pinned[i];
+	}
+	tail[0] = 31981;	/* was a multiple of 4; now 1 byte of tail */
+	tail[3] = 151;		/* was 148; now 3 bytes of tail */
+	run_case(tail, "word tail");
+
+	/* A zero-length blob is invalid, not an empty hash. */
+	{
+		struct pg_handoff handoff;
+
+		memset(&handoff, 0, sizeof(handoff));
+		handoff.blob[0].bytes = 0;
+		CHECK(polaris_gpu_hash_handoff(&handoff) == PG_EINVAL);
+		CHECK(polaris_gpu_hash_handoff(NULL) == PG_EINVAL);
+	}
+
+	/* A refused mapping must not leave a half-filled handoff behind. */
+	{
+		struct pg_handoff handoff;
+
+		memset(&handoff, 0, sizeof(handoff));
+		handoff.blob[0].pa = 0;	/* ml_io_map returns 0 for pa 0 */
+		handoff.blob[0].bytes = 4096;
+		CHECK(polaris_gpu_hash_handoff(&handoff) == PG_EMAP);
+		CHECK(handoff.blob[0].sha256[0] == 0);
+	}
+
+	if (failures != 0) {
+		printf("%u check(s) failed\n", failures);
+		return 1;
+	}
+	printf("hash copy path matches the source for every pinned size\n");
+	return 0;
+}
