diff --git a/bsd/dev/polaris_gpu_hash.c b/bsd/dev/polaris_gpu_hash.c
new file mode 100644
index 0000000..d33eb86
--- /dev/null
+++ b/bsd/dev/polaris_gpu_hash.c
@@ -0,0 +1,122 @@
+/*
+ * Polaris A630 firmware hashing -- see polaris_gpu_hash.h for the contract.
+ *
+ * Two hardware facts shape this file:
+ *
+ * 1. The firmware pages are ADT-reserved DRAM, not free boot memory, so
+ *    ml_static_ptovirt() cannot reach them (it only knows regions the booter
+ *    released). This port maps every other physical range with ml_io_map(),
+ *    so the same primitive is used here.
+ *
+ * 2. ml_io_map() gives Device-nGnRnE attributes on arm64. Device memory
+ *    forbids unaligned accesses, so the copy is done with 32-bit reads into a
+ *    bounce buffer and a byte tail, never with memcpy() over the mapping.
+ *
+ * SHA-256 is the kernel's own: libkern/crypto/sha2.h, which 0023 already
+ * routes to the built-in LTC implementation for SWEET (there is no corecrypto
+ * kext on this port). No crypto code is duplicated here.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+/*
+ * vm_offset_t/vm_size_t live here; sys/param.h does not promise them
+ * transitively, and the ml_io_map prototype below needs the exact types.
+ * Apple's IOPCIFamily declares the same prototype for its own MMIO maps.
+ */
+#include <mach/vm_types.h>
+#include <libkern/crypto/sha2.h>
+
+#include "polaris_gpu_hash.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/* Bounce buffer for the Device-memory copy; one blob is hashed per chunk. */
+#define PG_HASH_CHUNK	256u
+
+static void
+polaris_gpu_copy_in(void *dst, vm_offset_t src, size_t len)
+{
+	volatile const uint32_t *words = (volatile const uint32_t *)(uintptr_t)src;
+	volatile const uint8_t *bytes = (volatile const uint8_t *)(uintptr_t)src;
+	uint8_t *out = dst;
+	size_t i;
+
+	/*
+	 * arm64 is little endian, so a 32-bit word holds the same four bytes in
+	 * the same order as the source. Keeping the loop at 32-bit keeps every
+	 * access naturally aligned for the Device mapping.
+	 */
+	for (i = 0; i + sizeof(uint32_t) <= len; i += sizeof(uint32_t)) {
+		uint32_t word = words[i / sizeof(uint32_t)];
+
+		out[i] = (uint8_t)(word & 0xffu);
+		out[i + 1] = (uint8_t)((word >> 8) & 0xffu);
+		out[i + 2] = (uint8_t)((word >> 16) & 0xffu);
+		out[i + 3] = (uint8_t)((word >> 24) & 0xffu);
+	}
+	for (; i < len; ++i) {
+		out[i] = bytes[i];
+	}
+}
+
+static enum pg_status
+polaris_gpu_hash_one(const struct pg_blob *blob, uint8_t out[PG_HASH_BYTES])
+{
+	uint8_t bounce[PG_HASH_CHUNK];
+	SHA256_CTX ctx;
+	vm_offset_t va;
+	uint64_t done;
+
+	/*
+	 * Caller already proved this range lies inside XNU-managed DRAM, which
+	 * the pure layer caps at PG_MAX_DRAM; only emptiness is left to reject.
+	 */
+	if (blob->bytes == 0) {
+		return PG_EINVAL;
+	}
+	va = ml_io_map((vm_offset_t)blob->pa, (vm_size_t)blob->bytes);
+	if (va == 0) {
+		return PG_EMAP;
+	}
+	SHA256_Init(&ctx);
+	for (done = 0; done < blob->bytes; ) {
+		size_t take = PG_HASH_CHUNK;
+
+		if (blob->bytes - done < (uint64_t)take) {
+			take = (size_t)(blob->bytes - done);
+		}
+		polaris_gpu_copy_in(bounce, va + (vm_offset_t)done, take);
+		SHA256_Update(&ctx, bounce, take);
+		done += take;
+	}
+	SHA256_Final(out, &ctx);
+	return PG_OK;
+}
+
+enum pg_status
+polaris_gpu_hash_handoff(struct pg_handoff *handoff)
+{
+	enum pg_status status;
+	uint32_t i;
+
+	if (handoff == NULL) {
+		return PG_EINVAL;
+	}
+	for (i = 0; i < PG_BLOB_COUNT; ++i) {
+		status = polaris_gpu_hash_one(&handoff->blob[i],
+		    handoff->blob[i].sha256);
+		if (status != PG_OK) {
+			/*
+			 * Clear the digests on failure so a later reader cannot
+			 * mistake a partially filled handoff for a proven one.
+			 */
+			memset(handoff->blob[i].sha256, 0, PG_HASH_BYTES);
+			return status;
+		}
+	}
+	return PG_OK;
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/polaris_gpu_hash.h b/bsd/dev/polaris_gpu_hash.h
new file mode 100644
index 0000000..b1b1f6a
--- /dev/null
+++ b/bsd/dev/polaris_gpu_hash.h
@@ -0,0 +1,27 @@
+/*
+ * Polaris A630 firmware hashing. Read-only: maps the firmware bytes that the
+ * ADT already described, hashes them, and returns. It never writes to the
+ * source range, never touches a GPU register, and never starts firmware.
+ *
+ * The caller MUST have run pg_validate_layout() first: this file trusts that
+ * every blob address is page aligned and lies inside XNU-managed DRAM, so it
+ * can map without re-deriving those facts.
+ */
+#ifndef _BSD_DEV_POLARIS_GPU_HASH_H_
+#define _BSD_DEV_POLARIS_GPU_HASH_H_
+
+#include "polaris_gpu_validate.h"
+
+/*
+ * Fill handoff->blob[i].sha256 from the memory each blob describes.
+ *
+ * Returns PG_OK, PG_EINVAL, or PG_EMAP when a range cannot be mapped for
+ * reading. On any failure the caller must treat the digests as unproven; this
+ * function does not partially "repair" a handoff. Mapping failures are
+ * expected on an image whose payload does not describe the firmware at all,
+ * which is exactly the current 0090 layout.
+ */
+enum pg_status
+polaris_gpu_hash_handoff(struct pg_handoff *handoff);
+
+#endif /* _BSD_DEV_POLARIS_GPU_HASH_H_ */
