+/*
+ * M1b, deferred: let the CM3 out of reset twenty seconds after boot has moved on.
+ *
+ * Clearing SYSRESET reliably kills the machine, and it does so before the next printf -
+ * so every attempt so far has been paid for with a hang and a manual power cycle, and
+ * has polluted every experiment that followed. Scheduling it late changes the price: the
+ * system is already up, so a hang costs nothing that has not already been collected.
+ *
+ * The window is mapped again here because the earlier one belongs to a different call.
+ */
+static void
+polaris_gx_m1b_release_deferred(void *arg)
+{
+	vm_offset_t win;
+	uint32_t sr, cfg;
+
+	(void)arg;
+	win = ml_io_map((vm_offset_t)POLARIS_GMU_PA, (vm_size_t)POLARIS_GMU_SIZE);
+	if (win == 0) {
+		printf("POLARIS GPU: deferred release: window map failed\n");
+		return;
+	}
+	printf("POLARIS GPU: deferred release: starting\n");
+	sr = *(volatile uint32_t *)(uintptr_t)(win + 0x5000u * 4u);
+	cfg = *(volatile uint32_t *)(uintptr_t)(win + 0x5001u * 4u);
+	printf("POLARIS GPU: deferred release: sysreset 0x%08x bootcfg 0x%08x\n", sr, cfg);
+
+	*(volatile uint32_t *)(uintptr_t)(win + 0x5184u * 4u) = 1u;
+	*(volatile uint32_t *)(uintptr_t)(win + 0x5185u * 4u) = POLARIS_HFI_PA;
+	*(volatile uint32_t *)(uintptr_t)(win + 0x5182u * 4u) = POLARIS_HFI_PA + 120u;
+	*(volatile uint32_t *)(uintptr_t)(win + 0x5001u * 4u) = 0u;
+#if defined(__aarch64__)
+	__asm__ volatile ("dsb sy" ::: "memory");
+#endif
+	printf("POLARIS GPU: deferred release: table and config set, clearing reset now\n");
+	delay(1300000);
+	*(volatile uint32_t *)(uintptr_t)(win + 0x5000u * 4u) = sr & ~1u;
+#if defined(__aarch64__)
+	__asm__ volatile ("dsb sy" ::: "memory");
+#endif
+	delay(1000);
+	printf("POLARIS GPU: deferred release: fw_init 0x%08x, table 0x%08x\n",
+	    *(volatile uint32_t *)(uintptr_t)(win + 0x501cu * 4u),
+	    *(volatile uint32_t *)(uintptr_t)(win + 0x5185u * 4u));
+}
