+/*
+ * M1i: the RSC wake sequence.
+ *
+ * a6xx_rpmh_power_on_gpu does this before it touches a single GMU register, and this port
+ * never has: a probe of ours even printed "write RSCC_CONTROL_REQ allowed (plan only;
+ * nothing written)" and then moved on. Without it the GMU sits unpowered, which is exactly
+ * what "every read returns zero, the first real write faults" looks like.
+ */
+#define POLARIS_V_RSCC_CONTROL_REQ	0x23B07u
+#define POLARIS_V_RSCC_CONTROL_ACK	0x23B08u
+#define POLARIS_V_RSCC_SEQ_BUSY_DRV0	0x23501u
+#define POLARIS_V_POWER_COUNTER_EN	0x1F840u
+#define POLARIS_V_GX_DOMAIN_MISC	0x24542u
+
+static void
+polaris_gx_m1i_rsc_wake(vm_offset_t win)
+{
+	uint32_t ack = 0;
+	unsigned int i;
+
+	printf("POLARIS GPU: m1i: gx_domain_misc 0x%08x, req 0x%08x, ack 0x%08x\n",
+	    polaris_reg_rd_b(win, POLARIS_V_GX_DOMAIN_MISC),
+	    polaris_reg_rd_b(win, POLARIS_V_RSCC_CONTROL_REQ),
+	    polaris_reg_rd_b(win, POLARIS_V_RSCC_CONTROL_ACK));
+	sweet_log_sync();
+	delay(200000);
+
+	printf("POLARIS GPU: m1i: requesting power through RSC (req |= BIT(1))\n");
+	sweet_log_sync();
+	polaris_reg_wr_b(win, POLARIS_V_RSCC_CONTROL_REQ, 2u);
+#if defined(__aarch64__)
+	__asm__ volatile ("dsb sy" ::: "memory");
+#endif
+
+	for (i = 0; i < 1000; i++) {
+		ack = polaris_reg_rd_b(win, POLARIS_V_RSCC_CONTROL_ACK);
+		if (ack & 2u) {
+			break;
+		}
+		delay(10);
+	}
+	printf("POLARIS GPU: m1i: ack 0x%08x after %u polls (%s)\n", ack, i,
+	    (ack & 2u) ? "RSC granted the request" : "no ack");
+	sweet_log_sync();
+	delay(200000);
+
+	if (ack & 2u) {
+		uint32_t busy = 0;
+
+		for (i = 0; i < 1000; i++) {
+			busy = polaris_reg_rd_b(win, POLARIS_V_RSCC_SEQ_BUSY_DRV0);
+			if (busy == 0) {
+				break;
+			}
+			delay(10);
+		}
+		printf("POLARIS GPU: m1i: seq_busy 0x%08x after %u polls\n", busy, i);
+		polaris_reg_wr_b(win, POLARIS_V_RSCC_CONTROL_REQ, 0u);
+		polaris_reg_wr_b(win, POLARIS_V_POWER_COUNTER_EN, 1u);
+		sweet_log_sync();
+		delay(200000);
+	}
+
+	printf("POLARIS GPU: m1i: after wake, +0x14610 = 0x%08x, +0x1F800 = 0x%08x (%s)\n",
+	    polaris_reg_rd_b(win, 0x14610u), polaris_reg_rd_b(win, 0x1F800u),
+	    (polaris_reg_rd_b(win, 0x14610u) != 0u) ? "CSRs are alive" : "still zeros");
+	sweet_log_sync();
+}
+
