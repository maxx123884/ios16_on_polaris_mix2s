+/*
+ * Dump the RPMh command DB into the console ring, then parse it on the host.
+ *
+ * The DB maps resource names ("gpu_cc_cx_gdsc" and friends) to the address a TCS vote has to
+ * name. A vote written to the wrong address is a whole-device risk, so the addresses come
+ * from the table, never from a guess. This runs on the safe path - step 10 - because the
+ * deeper steps have been unreliable to start.
+ */
+static void
+polaris_gx_m1n_cmddb_dump(vm_offset_t cdb)
+{
+	unsigned int off;
+
+	printf("POLARIS GPU: m1n: command DB dump from 0x0C3F0000\n");
+	sweet_log_sync();
+	delay(200000);
+
+	for (off = 0; off < 0x600; off += 16) {
+		char ascii[17];
+		unsigned int i;
+
+		for (i = 0; i < 16; i++) {
+			uint8_t c = *(volatile uint8_t *)(uintptr_t)(cdb + off + i);
+
+			ascii[i] = (c >= 32 && c < 127) ? (char)c : '.';
+		}
+		ascii[16] = 0;
+		printf("POLARIS GPU: m1n: %03x %08x %08x %08x %08x |%s|\n", off,
+		    polaris_reg_rd_b(cdb, off), polaris_reg_rd_b(cdb, off + 4u),
+		    polaris_reg_rd_b(cdb, off + 8u), polaris_reg_rd_b(cdb, off + 12u), ascii);
+	}
+	printf("POLARIS GPU: m1n: dump done\n");
+	sweet_log_sync();
+}
