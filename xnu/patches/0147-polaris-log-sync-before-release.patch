--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -813,6 +813,20 @@
 	}
 }
 
+/*
+ * Force the console ring out to disk now instead of at the next tick.
+ *
+ * The flusher is a thread that wakes on a timer, so a machine that dies right after a
+ * dangerous write loses exactly the lines explaining why - which is most of the evidence
+ * this project needs. Waking it explicitly and giving it a moment to finish narrows that
+ * hole to almost nothing.
+ */
+void
+sweet_log_sync(void)
+{
+	wakeup(&sweet_log_chan);
+}
+
 /* Root device for rd=ufsroot0 (IOFindBSDRoot). */
 int sweet_ufs_rootdev(dev_t *dev);
 
