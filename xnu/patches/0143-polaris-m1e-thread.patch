+static void polaris_gx_m1e_vendor_deferred(void *arg);
+
+
+/* A kernel thread is a reliable trigger where timeout() was not: the scheduler is up long
+ * before this probe runs, and the thread keeps its own stack. It sleeps fifteen seconds,
+ * by which point the platform has taken CX away - which is exactly why the sequence
+ * re-powers it first. */
+static void
+polaris_m1e_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+
+	printf("POLARIS GPU: m1e thread: started, sleeping 15 s\n");
+	(void)tsleep(&chan, 0, "polarism1e", 15 * hz);
+	printf("POLARIS GPU: m1e thread: awake\n");
+	polaris_gx_m1e_vendor_deferred(NULL);
+}
