-static const uint64_t pg_device_bytes[PG_BLOB_COUNT] = {
-	32136,	/* a630_sqe.fw   */
-	32768,	/* a630_gmu.bin  */
-	6684,	/* a630_zap.mdt  */
-	148,	/* a630_zap.b00  */
-	6536,	/* a630_zap.b01  */
-	1968	/* a630_zap.b02  */
-};
-
 static const char *const pg_status_text[] = {
 	"ok",
 	"invalid argument",
@@ -115,7 +101,16 @@ pg_expect_complete(const struct pg_expect *expect, size_t count)
 		return false;
 	}
 	for (i = 0; i < count; ++i) {
-		if (expect[i].bytes != pg_device_bytes[i]) {
+		/*
+		 * The table is the authority on which firmware set is expected; a
+		 * zero size is simply "not filled in yet". It is NOT compared
+		 * against pg_device_bytes[]: one official bundle (MIUI 12.5.1)
+		 * ships an earlier a630_sqe.fw than the handset this port was
+		 * measured on, and pinning that set by name is a reviewed change,
+		 * not a loosened check. pg_validate_handoff() still refuses any
+		 * size that differs from what the table states.
+		 */
+		if (expect[i].bytes == 0) {
 			return false;
 		}
 		if (pg_all_zero(expect[i].sha256, PG_HASH_BYTES)) {
@@ -139,6 +134,13 @@ pg_validate_handoff(const struct pg_handoff *handoff,
 	if (!handoff->adt_polaris || !handoff->adt_sdm845) {
 		return PG_EBOARD;
 	}
+	/*
+	 * An incomplete table is "no expectation yet", so it must be reported
+	 * before any size comparison would blame the firmware for it.
+	 */
+	if (!pg_expect_complete(expect, PG_BLOB_COUNT)) {
+		return PG_EHASH_UNPROVEN;
+	}
 	if (!pg_has_end(&handoff->dram, &dram_end) ||
 	    (handoff->dram.base & (PG_PAGE - 1)) != 0 ||
 	    handoff->dram.size > PG_MAX_DRAM) {
@@ -162,8 +164,13 @@ pg_validate_handoff(const struct pg_handoff *handoff,
 		const struct pg_blob *blob = &handoff->blob[i];
 		uint64_t reserve, blob_end;
 
-		/* Size first: an unexpected firmware set is a hard refusal. */
-		if (blob->bytes != pg_device_bytes[i]) {
+		/*
+		 * Size first: the pinned set is the only accepted firmware. This
+		 * used to compare against one handset's observed sizes; the table
+		 * now carries them, so a reviewed set with an earlier SQE revision
+		 * is expressible without ever widening the check.
+		 */
+		if (blob->bytes != expect[i].bytes) {
 			return PG_EBLOB_SIZE;
 		}
 		if ((blob->pa & (PG_PAGE - 1)) != 0) {
@@ -192,11 +199,17 @@ pg_validate_handoff(const struct pg_handoff *handoff,
 		mapped += reserve;
 	}
 
-	/* Layout alone never authorises firmware: the digests must be proven. */
-	if (!pg_expect_complete(expect, PG_BLOB_COUNT)) {
-		return PG_EHASH_UNPROVEN;
-	}
+	/*
+	 * Layout alone never authorises firmware: the digests must be proven.
+	 * A zero digest in the handoff means these bytes were never hashed by
+	 * this kernel, which is "unproven", not "wrong" -- reporting a mismatch
+	 * there would point a debugger at the firmware instead of the missing
+	 * backend.
+	 */
 	for (i = 0; i < PG_BLOB_COUNT; ++i) {
+		if (pg_all_zero(handoff->blob[i].sha256, PG_HASH_BYTES)) {
+			return PG_EHASH_UNPROVEN;
+		}
 		if (!pg_same(handoff->blob[i].sha256, expect[i].sha256, PG_HASH_BYTES)) {
 			return PG_EHASH_MISMATCH;
 		}
