+
+/*
+ * Two reads, one boot, with the log forced out between them.
+ *
+ * +0x14610 is known to answer - the old HFI code read it and got values back. +0x1F800 is
+ * CM3_SYSRESET, the register the whole M1b step has been aiming at. Reading the known one
+ * first means that if the machine dies, the last line on disk says whether it died on a
+ * read that should work, on the flush, or on the register we actually need.
+ */
+static void
+polaris_gx_m1g_probe_two(vm_offset_t win)
+{
+	uint32_t v;
+
+	printf("POLARIS GPU: m1g: probe A, reading +0x14610 (known good)\n");
+	sweet_log_sync();
+	delay(300000);
+	v = polaris_reg_rd_b(win, 0x14610u);
+	printf("POLARIS GPU: m1g: A +0x14610 = 0x%08x\n", v);
+	sweet_log_sync();
+	delay(300000);
+
+	printf("POLARIS GPU: m1g: probe B, reading +0x1F800 (CM3_SYSRESET)\n");
+	sweet_log_sync();
+	delay(300000);
+	v = polaris_reg_rd_b(win, 0x1F800u);
+	printf("POLARIS GPU: m1g: B +0x1F800 = 0x%08x\n", v);
+	sweet_log_sync();
+	printf("POLARIS GPU: m1g: both reads answered\n");
+}
+
